---
import SectionHeading, { type HeadingContent } from "@/components/ui/SectionHeading.astro";
import Container from "@/components/ui/Container.astro";
import JsonLd from "@/components/JsonLd.astro";
import { cn } from "@/lib/utils";

export interface FaqContent {
  heading: HeadingContent;
  items: { question: string; answer: string }[];
}

interface Props {
  content: FaqContent;
  /** Open the first question by default (as in Figma). */
  openFirst?: boolean;
  /** Add FAQPage JSON-LD (only one FAQ block per page should do this). */
  schema?: boolean;
  id?: string;
  /** Extra classes for the section, e.g. "bg-canvas" to change the background. */
  class?: string;
}

/**
 * FAQ: heading on the left, accordion on the right (Figma "Section / FAQ").
 * Built on <details>/<summary>, so it works without JavaScript. With JavaScript the
 * height eases open and shut (both items at the same time), the answer fades and
 * slides in, the icon turns at once, and only one item is open at a time.
 */
const { content, openFirst = true, schema = true, id = "faq", class: className } = Astro.props;
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<section id={id} class={cn(!className?.includes("bg-") && "bg-canvas-2", "py-20 lg:py-[120px]", className)}>
  {schema && <JsonLd data={faqLd} />}
  <Container class="grid gap-10 lg:grid-cols-[minmax(0,474fr)_minmax(0,710fr)] lg:gap-16">
    <div data-reveal><SectionHeading {...content.heading} descriptionClass="max-w-[429px]" /></div>
    <div class="flex flex-col gap-3" data-faq data-stagger>
      {
        content.items.map((item, i) => (
          <details class="faq-item group rounded-panel bg-surface" open={openFirst && i === 0} name={`${id}-accordion`} data-state={openFirst && i === 0 ? "open" : "closed"}>
            <summary class="flex list-none items-center gap-6 rounded-panel px-5 py-[22px] outline-offset-[-2px] sm:px-7 [&::-webkit-details-marker]:hidden">
              <span class="faq-q flex-1 text-h4 font-medium tracking-normal text-ink">{item.question}</span>
              <span class="faq-icon relative flex size-7 shrink-0 items-center justify-center rounded-full bg-sky text-ink" aria-hidden="true">
                <span class="absolute h-[1.5px] w-3 rounded-full bg-current" />
                <span class="absolute h-3 w-[1.5px] rounded-full bg-current" />
              </span>
            </summary>
            <div data-faq-body class="faq-body overflow-hidden">
              <p class="faq-a max-w-[602px] px-5 pb-[22px] text-base leading-[26px] text-muted sm:px-7">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</section>

<style>
  /* Answer sits 12px under the question (Figma): pull the body up over the summary's 22px bottom padding. */
  .faq-item[open] .faq-body {
    margin-top: -10px;
  }

  .faq-item {
    transition:
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease;
  }
  .faq-icon {
    transition:
      rotate 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.3s ease,
      color 0.3s ease,
      scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .faq-q {
    transition: color 0.25s ease;
  }

  /* Open state: driven by data-state with JS (changes at once), by [open] without JS. */
  .faq-item[data-state="open"] .faq-icon,
  html:not(.js) .faq-item[open] .faq-icon {
    rotate: 45deg;
    background-color: var(--brand);
    color: var(--canvas);
  }
  .faq-item[data-state="open"] {
    box-shadow: 0 1px 2px 0 rgb(50 25 4 / 0.04), 0 12px 32px -12px rgb(50 25 4 / 0.12);
  }

  @media (hover: hover) {
    .faq-item[data-state="closed"]:hover .faq-q {
      color: var(--brand);
    }
    .faq-item[data-state="closed"]:hover .faq-icon {
      scale: 1.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-icon,
    .faq-q {
      transition: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const EASE = "cubic-bezier(0.32, 0.72, 0, 1)"; // smooth, no overshoot
  const OPEN_MS = 520;
  const CLOSE_MS = 420;

  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((list) => {
    const items = [...list.querySelectorAll<HTMLDetailsElement>("details")];
    // JS handles "one open at a time" itself: the native `name` grouping would snap the other item shut.
    items.forEach((d) => d.removeAttribute("name"));
    const anims = new WeakMap<HTMLDetailsElement, Animation[]>();

    const stop = (d: HTMLDetailsElement) => {
      anims.get(d)?.forEach((a) => a.cancel());
      anims.delete(d);
    };

    function setOpen(d: HTMLDetailsElement, open: boolean) {
      const body = d.querySelector<HTMLElement>("[data-faq-body]");
      const text = body?.firstElementChild as HTMLElement | null;
      if (!body || !text) return;
      if ((d.dataset.state === "open") === open) return;

      // Start from the current on-screen height, even mid-animation.
      const from = d.open ? body.getBoundingClientRect().height : 0;
      const fromMargin = d.open ? getComputedStyle(body).marginTop : "0px";
      stop(d);
      d.dataset.state = open ? "open" : "closed";

      if (reduce.matches) {
        d.open = open;
        return;
      }

      if (open) {
        d.open = true;
        const to = body.scrollHeight;
        const a = body.animate(
          [
            { height: `${from}px`, marginTop: fromMargin },
            { height: `${to}px`, marginTop: "-10px" },
          ],
          { duration: OPEN_MS, easing: EASE },
        );
        const b = text.animate(
          [
            { opacity: 0, transform: "translateY(-6px)", filter: "blur(3px)" },
            { opacity: 1, transform: "none", filter: "blur(0)" },
          ],
          { duration: OPEN_MS, delay: 60, easing: EASE, fill: "backwards" },
        );
        anims.set(d, [a, b]);
        a.onfinish = () => anims.delete(d);
      } else {
        const a = body.animate(
          [
            { height: `${from}px`, marginTop: fromMargin },
            { height: "0px", marginTop: "0px" },
          ],
          { duration: CLOSE_MS, easing: EASE, fill: "forwards" },
        );
        const b = text.animate([{ opacity: 1 }, { opacity: 0 }], { duration: CLOSE_MS * 0.6, easing: "ease-out", fill: "forwards" });
        anims.set(d, [a, b]);
        a.onfinish = () => {
          d.open = false;
          stop(d);
        };
      }
    }

    items.forEach((d) => {
      d.querySelector("summary")?.addEventListener("click", (event) => {
        event.preventDefault();
        const opening = d.dataset.state !== "open";
        if (opening) items.forEach((other) => other !== d && setOpen(other, false));
        setOpen(d, opening);
      });
    });
  });
</script>
