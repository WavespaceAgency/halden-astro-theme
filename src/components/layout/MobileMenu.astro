---
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { cn, isActivePath } from "@/lib/utils";

/**
 * Menu for screens below 1024px (not designed in Figma – see docs/DECISIONS.md).
 * The same button turns from ☰ into ✕. The panel fills the screen below the header.
 * Closes with Escape, the button or a link click. Focus stays inside while open; the page does not scroll.
 */
const pathname = Astro.url.pathname;
const links = [{ label: "Home", href: "/" }, ...siteConfig.nav.main];
const extra = siteConfig.nav.pages.filter((p) => !links.some((l) => l.href === p.href));
const bar = "absolute left-1/2 h-[1.5px] w-5 -translate-x-1/2 rounded-full bg-current transition-transform duration-300";
---

<button
  type="button"
  data-menu-toggle
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-label="Open menu"
  class="group relative -mr-2 flex size-11 items-center justify-center rounded-xl text-ink hover:bg-ink/5 lg:hidden"
>
  <span class={cn(bar, "top-[17px] group-aria-expanded:top-[21px] group-aria-expanded:rotate-45")}></span>
  <span class={cn(bar, "top-[25px] group-aria-expanded:top-[21px] group-aria-expanded:-rotate-45")}></span>
</button>

<div id="mobile-menu" data-menu-panel hidden class="fixed inset-x-0 bottom-0 z-50 overflow-y-auto bg-canvas lg:hidden" style="top: 64px">
  <nav aria-label="Mobile" class="flex min-h-full flex-col px-4 pt-2 pb-8 sm:px-6">
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActivePath(pathname, link.href) ? "page" : undefined}
              class="flex min-h-14 items-center border-b border-line text-[22px] font-medium tracking-[-0.01em] text-ink aria-[current=page]:text-brand"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="eyebrow mt-8 mb-2 text-muted">{siteConfig.nav.pagesLabel}</p>
    <ul class="grid grid-cols-2 gap-x-4">
      {
        extra.map((link) => (
          <li>
            <a href={link.href} class="flex min-h-11 items-center text-[15px] text-body hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <Button href={siteConfig.cta.href} variant="primary" size="lg" class="mt-auto w-full">{siteConfig.cta.label}</Button>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  if (toggle && panel) {
    let open = false;
    let saved = { overflow: "", paddingRight: "" };
    const focusables = () => [toggle, ...panel.querySelectorAll<HTMLElement>("a")];

    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
      }
      if (event.key === "Tab") {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    };

    function setOpen(next: boolean) {
      if (next === open) return;
      open = next;
      toggle!.setAttribute("aria-expanded", String(open));
      toggle!.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (open) {
        const header = toggle!.closest("header");
        if (header) panel!.style.top = `${Math.round(header.getBoundingClientRect().bottom)}px`;
        const scrollbar = window.innerWidth - document.documentElement.clientWidth;
        saved = { overflow: document.body.style.overflow, paddingRight: document.body.style.paddingRight };
        document.body.style.overflow = "hidden";
        if (scrollbar > 0) document.body.style.paddingRight = `${scrollbar}px`;
        panel!.hidden = false;
        document.addEventListener("keydown", onKey);
      } else {
        document.body.style.overflow = saved.overflow;
        document.body.style.paddingRight = saved.paddingRight;
        document.removeEventListener("keydown", onKey);
        panel!.hidden = true;
      }
    }

    toggle.addEventListener("click", () => setOpen(!open));
    panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && setOpen(false));
  }
</script>
