---
import { buttonClasses } from "@/lib/button";
import { siteConfig } from "@/config/site";
import { cn, isActivePath } from "@/lib/utils";

/**
 * Menu for screens below 1024px, as on the Framer build: the panel drops down from the header,
 * the two bars turn into ✕ and the links fade in one by one.
 * Closes with Escape, the button, a link click or a tap outside. Focus stays inside while open;
 * the page behind does not scroll.
 */
const pathname = Astro.url.pathname;
const links = siteConfig.nav.main;
const extra = siteConfig.nav.pages.filter((p) => !links.some((l) => l.href === p.href));
const bar = "absolute left-1/2 h-0.5 w-[22px] -translate-x-1/2 rounded-full bg-current transition-[top,rotate] duration-300 ease-out-expo";
const item = "menu-item flex min-h-11 items-center text-base text-ink transition-colors hover:text-brand aria-[current=page]:text-brand";
---

<button
  type="button"
  data-menu-toggle
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-label="Open menu"
  class="group relative -mr-1.5 flex size-11 items-center justify-center rounded-xl text-ink transition-colors hover:bg-sky-tint lg:hidden"
>
  <span class={cn(bar, "top-[17px] group-aria-expanded:top-[21px] group-aria-expanded:rotate-45")}></span>
  <span class={cn(bar, "top-[25px] group-aria-expanded:top-[21px] group-aria-expanded:-rotate-45")}></span>
</button>

<!-- Tap-outside layer (transparent, below the panel) -->
<div data-menu-scrim class="fixed inset-0 top-16 z-30 hidden bg-ink/10 opacity-0 transition-opacity duration-300 lg:hidden"></div>

<div
  id="mobile-menu"
  data-menu-panel
  class="absolute inset-x-0 top-full z-40 grid grid-rows-[0fr] border-b border-transparent bg-surface transition-[grid-template-rows,border-color] duration-500 ease-out-expo data-[open]:grid-rows-[1fr] data-[open]:border-line lg:hidden"
  inert
>
  <div class="overflow-hidden">
    <nav aria-label="Mobile" class="max-h-[calc(100dvh-4rem)] overflow-y-auto px-5 pt-1.5 pb-6">
      <ul class="flex flex-col">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActivePath(pathname, link.href) ? "page" : undefined} class={item}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="menu-item mt-4 mb-1 font-mono text-xs tracking-[0.06em] text-muted uppercase">{siteConfig.nav.pagesLabel}</p>
      <ul class="grid grid-cols-2 gap-x-4">
        {
          extra.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActivePath(pathname, link.href) && link.href !== "/404" ? "page" : undefined}
                class={item}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={siteConfig.cta.href} class={buttonClasses({ variant: "dark", size: "md", className: "menu-item mt-5 w-full rounded-[14px]" })}>
        {siteConfig.cta.label}
      </a>
    </nav>
  </div>
</div>

<style>
  /* Links fade and rise in one by one while the panel opens. */
  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu .menu-item {
      opacity: 0;
      translate: 0 -6px;
      transition:
        opacity 0.35s ease-out,
        translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: 0s;
    }
    #mobile-menu[data-open] .menu-item {
      opacity: 1;
      translate: 0 0;
      transition-delay: calc(0.06s + var(--i, 0) * 0.035s);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const scrim = document.querySelector<HTMLElement>("[data-menu-scrim]");

  if (toggle && panel && scrim) {
    let open = false;
    panel.querySelectorAll<HTMLElement>(".menu-item").forEach((el, i) => el.style.setProperty("--i", String(i)));
    const focusables = () => [toggle, ...panel.querySelectorAll<HTMLElement>("a")];

    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
      }
      if (event.key === "Tab") {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    };

    function setOpen(next: boolean) {
      if (next === open) return;
      open = next;
      toggle!.setAttribute("aria-expanded", String(open));
      toggle!.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel!.toggleAttribute("data-open", open);
      panel!.inert = !open;
      document.documentElement.classList.toggle("menu-open", open);
      window.dispatchEvent(new CustomEvent(open ? "scroll-lock" : "scroll-unlock"));
      if (open) {
        scrim!.classList.remove("hidden");
        requestAnimationFrame(() => scrim!.classList.add("opacity-100"));
        document.addEventListener("keydown", onKey);
      } else {
        scrim!.classList.remove("opacity-100");
        window.setTimeout(() => !open && scrim!.classList.add("hidden"), 300);
        document.removeEventListener("keydown", onKey);
      }
    }

    toggle.addEventListener("click", () => setOpen(!open));
    scrim.addEventListener("click", () => setOpen(false));
    panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && setOpen(false));
  }
</script>
