---
import Button from "@/components/ui/Button.astro";
import Logo from "@/components/ui/Logo.astro";
import { siteConfig } from "@/config/site";
import { cn, isActivePath } from "@/lib/utils";
import MobileMenu from "./MobileMenu.astro";

const pathname = Astro.url.pathname;
const { main, pages, pagesLabel } = siteConfig.nav;
const link =
  "flex min-h-11 items-center rounded-xl px-3 text-nav text-ink transition-colors hover:bg-ink/5 aria-[current=page]:text-brand";
---

<header class="sticky top-0 z-40 bg-canvas/90 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/80">
  <div class="relative mx-auto flex h-16 max-w-[90rem] items-center justify-between px-4 sm:px-6 lg:h-[84px] lg:px-8">
    <Logo />

    <!-- Desktop navigation (1024px and up), centred like the Figma frame -->
    <nav aria-label="Main" class="absolute left-1/2 hidden -translate-x-1/2 lg:block">
      <ul class="flex items-center gap-1">
        <li class="relative" data-dropdown>
          <button
            type="button"
            class={cn(link, "gap-1.5 text-ink-2")}
            aria-expanded="false"
            aria-controls="pages-menu"
            data-dropdown-toggle
          >
            {pagesLabel}
            <svg class="size-3.5 transition-transform duration-200 [[aria-expanded=true]>&]:rotate-180" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
              <path d="M12.63 4.667 7 10.296 1.37 4.667l.83-.829L7 8.645l4.8-4.8.83.822Z"></path>
            </svg>
          </button>
          <div
            id="pages-menu"
            hidden
            data-dropdown-panel
            class="absolute top-full left-1/2 mt-2 w-[440px] -translate-x-1/2 rounded-panel border border-line bg-surface p-2 shadow-lift"
          >
            <ul class="grid grid-cols-2 gap-0.5">
              {
                pages.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      aria-current={isActivePath(pathname, page.href) && page.href !== "/404" ? "page" : undefined}
                      class="flex min-h-11 items-center rounded-chip px-3 text-[15px] text-ink transition-colors hover:bg-sky-tint aria-[current=page]:text-brand"
                    >
                      {page.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          main.map((item) => (
            <li>
              <a href={item.href} class={link} aria-current={isActivePath(pathname, item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <Button href={siteConfig.cta.href} variant="dark" class="hidden sm:inline-flex">{siteConfig.cta.label}</Button>
      <MobileMenu />
    </div>
  </div>
</header>

<script>
  const root = document.querySelector<HTMLElement>("[data-dropdown]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
  const panel = root?.querySelector<HTMLElement>("[data-dropdown-panel]");

  if (root && toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
  }
</script>
