---
import Button from "@/components/ui/Button.astro";
import Logo from "@/components/ui/Logo.astro";
import { siteConfig } from "@/config/site";
import { cn, isActivePath } from "@/lib/utils";
import MobileMenu from "./MobileMenu.astro";

/**
 * Full-width sticky header (as on the Framer build): 72px on desktop, 64px on phones,
 * logo left, links centred, button right. Below 1024px the links move into MobileMenu.
 * No backdrop-filter on the header itself: it would trap the fixed mobile menu inside it.
 * Like Framer, it slides away while scrolling down and comes back on any scroll up (320ms).
 */
const pathname = Astro.url.pathname;
const { main, pages, pagesLabel } = siteConfig.nav;
const link =
  "relative flex min-h-11 items-center rounded-xl px-3 text-nav text-ink transition-colors duration-200 hover:text-brand aria-[current=page]:text-brand";
---

<header
  class="sticky top-0 z-40 w-full bg-surface transition-transform duration-[320ms] ease-[cubic-bezier(0.22,1,0.36,1)] data-[hidden]:-translate-y-[110%] motion-reduce:transition-none"
  data-header
>
  <div class="relative flex h-16 w-full items-center justify-between px-5 lg:h-[72px] lg:px-8">
    <Logo />

    <!-- Desktop navigation (1024px and up), centred -->
    <nav aria-label="Main" class="absolute left-1/2 hidden -translate-x-1/2 lg:block">
      <ul class="flex items-center gap-1">
        <li class="relative" data-dropdown>
          <button type="button" class={cn(link, "gap-1.5 text-ink-2")} aria-expanded="false" aria-controls="pages-menu" data-dropdown-toggle>
            {pagesLabel}
            <svg class="size-3.5 transition-transform duration-300 ease-out-expo [[aria-expanded=true]>&]:rotate-180" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
              <path d="M12.63 4.667 7 10.296 1.37 4.667l.83-.829L7 8.645l4.8-4.8.83.822Z"></path>
            </svg>
          </button>
          <div
            id="pages-menu"
            data-dropdown-panel
            class="invisible absolute top-full left-1/2 mt-2 w-[440px] -translate-x-1/2 translate-y-2 scale-[0.98] rounded-panel border border-line bg-surface p-2 opacity-0 shadow-lift transition-[opacity,translate,scale,visibility] duration-300 ease-out-expo data-[open]:visible data-[open]:translate-y-0 data-[open]:scale-100 data-[open]:opacity-100"
          >
            <ul class="grid grid-cols-2 gap-0.5">
              {
                pages.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      aria-current={isActivePath(pathname, page.href) && page.href !== "/404" ? "page" : undefined}
                      class="group/item flex min-h-11 items-center justify-between rounded-chip px-3 text-[15px] text-ink transition-colors duration-200 hover:bg-sky-tint aria-[current=page]:text-brand"
                    >
                      {page.label}
                      <svg
                        class="size-3.5 -translate-x-1 text-brand opacity-0 transition-[opacity,translate] duration-300 ease-out-expo group-hover/item:translate-x-0 group-hover/item:opacity-100"
                        viewBox="0 0 14 14"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          main.map((item) => (
            <li>
              <a href={item.href} class={cn(link, "group/nav")} aria-current={isActivePath(pathname, item.href) ? "page" : undefined}>
                {item.label}
                <span
                  class="absolute inset-x-3 bottom-2 h-px origin-left scale-x-0 bg-current transition-transform duration-300 ease-out-expo group-hover/nav:scale-x-100"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden lg:block"><Button href={siteConfig.cta.href} variant="dark">{siteConfig.cta.label}</Button></div>
      <MobileMenu />
    </div>
  </div>
</header>

<script>
  // Hide on scroll down, show on scroll up (Framer: translateY -110%, 320ms, ease 0.22/1/0.36/1).
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    let last = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const busy = document.documentElement.classList.contains("menu-open") || header.querySelector("[data-dropdown-panel][data-open]") || header.contains(document.activeElement);
      if (y <= header.offsetHeight || busy) header.removeAttribute("data-hidden");
      else if (y > last + 2) header.setAttribute("data-hidden", "");
      else if (y < last - 2) header.removeAttribute("data-hidden");
      last = y;
    };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }

  const root = document.querySelector<HTMLElement>("[data-dropdown]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
  const panel = root?.querySelector<HTMLElement>("[data-dropdown-panel]");

  if (root && toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.toggleAttribute("data-open", open);
    };
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    toggle.addEventListener("click", () => setOpen(!isOpen()));
    // Open on hover for mouse users (click still works for touch and keyboard).
    let timer: number | undefined;
    root.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      window.clearTimeout(timer);
      setOpen(true);
    });
    root.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      timer = window.setTimeout(() => setOpen(false), 160);
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
  }
</script>
