---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"div"> {
  /** "site" = 1248px content column (96px sides at 1440). "wide" = 1376px (32px sides), used by the header and hero card. */
  size?: "site" | "wide";
}
const { size = "site", class: className, ...attrs } = Astro.props;
---

<div
  class={cn(
    "mx-auto w-full px-4 sm:px-6",
    size === "site" ? "max-w-[calc(var(--container-site)+3rem)] lg:px-12 xl:max-w-site xl:px-0" : "max-w-[calc(var(--container-wide)+4rem)] lg:px-8",
    className,
  )}
  {...attrs}
>
  <slot />
</div>
