---
import { playIcon } from "@/config/pages/shared";

interface Props {
  class?: string;
}
/** Circle-play icon for "Live Demo" buttons (Figma 18×18). Uses currentColor. */
const { class: className = "size-[18px]" } = Astro.props;
---

<svg class={className} viewBox="0 0 18 18" fill="none" aria-hidden="true">
  <path d={playIcon.circle} stroke="currentColor" stroke-width="1.25"></path>
  <path d={playIcon.triangle} fill="currentColor"></path>
</svg>
