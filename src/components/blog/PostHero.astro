---
import Container from "@/components/ui/Container.astro";
import { postPage } from "@/config/pages/blog";
import type { Post } from "@/lib/content";

interface Props {
  post: Post;
}
/** Breadcrumb, title and intro at the top of a post (Figma "Article hero"). */
const { data } = Astro.props.post;
const p = postPage;
---

<section class="pt-10 pb-10 lg:pt-[72px] lg:pb-12">
  <Container class="flex flex-col items-center gap-6 text-center">
    <nav aria-label={p.breadcrumbLabel}>
      <ol class="flex items-center gap-2 text-sm leading-[18px] text-body">
        <li><a href={p.breadcrumb.href} class="font-medium text-brand-deep hover:underline">{p.breadcrumb.label}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{data.category}</li>
      </ol>
    </nav>
    <div class="flex max-w-[838px] flex-col items-center gap-5">
      <h1 class="text-[40px] leading-[1.08] font-medium tracking-[-0.03em] text-ink-2 sm:text-5xl lg:text-[56px]" data-split="chars">{data.title}</h1>
      <p class="max-w-[630px] text-lg leading-[1.5] text-body sm:text-xl sm:leading-[30px]">{data.subtitle ?? data.excerpt}</p>
    </div>
  </Container>
</section>
