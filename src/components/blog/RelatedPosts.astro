---
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { postPage } from "@/config/pages/blog";
import { buttonClasses } from "@/lib/button";
import type { Post } from "@/lib/content";
import PostCard from "./PostCard.astro";

interface Props {
  /** Other posts, most related first. Shown three at a time with page buttons. */
  posts: Post[];
}
/** "Related Blogs" – more posts under an article, three per page (Figma "Press"). */
const { posts } = Astro.props;
const r = postPage.related;
const pages = Math.min(r.maxPages, Math.ceil(posts.length / r.count));
const shown = posts.slice(0, pages * r.count);
---

<section class="bg-canvas-2 py-20 lg:pt-[120px] lg:pb-[140px]">
  <Container class="flex flex-col gap-12">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="flex flex-col gap-4">
        <Eyebrow label={r.eyebrow.label} icon={r.eyebrow.icon} tone={r.eyebrow.tone} class="[&>span]:font-medium" />
        <h2 class="text-h1 leading-[1.3] font-medium text-ink-2">{r.title}</h2>
      </div>
      <a href={r.viewAll.href} class={buttonClasses({ variant: "outline", size: "xl", className: "border-black/16! bg-transparent!" })}>{r.viewAll.label}</a>
    </div>
    <ul class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3" id="related-posts" data-related-list>
      {
        shown.map((post, i) => (
          <li data-page={Math.floor(i / r.count)} hidden={i >= r.count}>
            <PostCard post={post} splitTitle />
          </li>
        ))
      }
    </ul>
    {
      pages > 1 && (
        <nav aria-label={r.paginationLabel}>
          <ul class="flex gap-2">
            {Array.from({ length: pages }, (_, i) => (
              <li>
                <button
                  type="button"
                  data-related-page={i}
                  aria-controls="related-posts"
                  aria-current={i === 0 ? "true" : undefined}
                  aria-label={`${r.pageLabel} ${i + 1}`}
                  class="flex size-11 items-center justify-center rounded-full border border-ink-2/12 bg-surface text-[15px] leading-5 font-medium text-ink-2 transition-colors hover:bg-sky-tint aria-[current=true]:border-brand-bright aria-[current=true]:bg-brand-bright aria-[current=true]:text-white lg:size-10"
                >
                  {i + 1}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </Container>
</section>

<script>
  import { reduceMotion } from "@/scripts/motion";

  const list = document.querySelector<HTMLElement>("[data-related-list]");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-related-page]"));
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const page = button.dataset.relatedPage;
      buttons.forEach((b) => (b === button ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current")));
      let n = 0;
      list?.querySelectorAll<HTMLLIElement>(":scope > li").forEach((li) => {
        li.hidden = li.dataset.page !== page;
        if (!li.hidden && !reduceMotion()) {
          li.animate(
            [
              { opacity: 0, transform: "translateY(16px)" },
              { opacity: 1, transform: "none" },
            ],
            { duration: 500, delay: n++ * 80, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "backwards" },
          );
        }
      });
    });
  });
</script>
