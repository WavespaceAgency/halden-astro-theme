---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cn } from "@/lib/utils";

interface Props {
  author: { name: string; avatar?: ImageMetadata };
  /** 24, 40 or 56px. */
  size?: 24 | 40 | 56;
  class?: string;
}

/** Author photo, or the initials on a pastel circle when the post has no photo (as in Figma). */
const { author, size = 24, class: className } = Astro.props;
const initials = author.name
  .replace(/^(Dr|Mr|Mrs|Ms|Prof)\.?\s+/i, "")
  .split(/\s+/)
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
const text = { 24: "text-[10px]", 40: "text-sm", 56: "text-lg" }[size];
---

<span
  class={cn("inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-sky-soft font-medium text-ink-2", text, className)}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
>
  {author.avatar ? <Image src={author.avatar} alt="" width={size * 2} height={size * 2} class="size-full object-cover" /> : initials}
</span>
