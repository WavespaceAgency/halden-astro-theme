---
/** "## Heading" in legal pages. MDX gives it a slug id (e.g. #your-rights-and-choices). */
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<h2 id={id} class="mt-12 scroll-mt-28 text-2xl leading-[1.2] font-medium tracking-[-0.015em] text-ink-2 first:mt-0 sm:text-[28px]"><slot /></h2>
