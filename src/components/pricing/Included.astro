---
import Container from "@/components/ui/Container.astro";
import SectionIntro from "@/components/security/SectionIntro.astro";
import { included } from "@/config/pages/pricing";

/** Figma "Included" (1440×927, light blue): "Every plan includes" – eight white cards with an icon tile. */
const s = included;
const tiles = { sky: "bg-[#c8defb]", violet: "bg-violet-tint", mint: "bg-mint-tint", lime: "bg-lime-tint" } as const;
---

<section class="bg-sky-tint py-20 lg:py-[120px]" aria-labelledby="included-title">
  <Container>
    <SectionIntro id="included-title" eyebrow={s.eyebrow} title={s.title} description={s.description} />
    <ul data-stagger class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        s.items.map((item) => (
          <li class="lift-card flex flex-col gap-6 rounded-card bg-surface p-5 sm:p-7 lg:min-h-[230px] lg:gap-[46px]">
            <span class={`inc-tile size-12 shrink-0 rounded-[14px] ${tiles[item.tone]}`} aria-hidden="true">
              <svg class="size-12" viewBox="0 0 48 48" fill="none">
                <path d={item.icon} stroke="var(--ink-2)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="text-h4 leading-6 font-medium text-ink" data-split="words">{item.title}</h3>
              <p class="text-base leading-[26px] text-body" data-split="words">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  /* Hover: the card lifts with a soft blue shadow and its icon tile tilts. */
  .lift-card {
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0s),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0s),
      translate 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .inc-tile {
    display: block;
    transition: rotate 0.6s cubic-bezier(0.34, 1.45, 0.64, 1), scale 0.6s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  @media (hover: hover) {
    .lift-card:hover {
      translate: 0 -4px;
      box-shadow: 0 2px 4px 0 rgb(12 40 90 / 0.04), 0 20px 44px -10px rgb(44 103 246 / 0.2);
    }
    .lift-card:hover .inc-tile {
      rotate: -6deg;
      scale: 1.06;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lift-card:hover {
      translate: none;
    }
    .lift-card:hover .inc-tile {
      rotate: none;
      scale: none;
    }
  }
</style>
