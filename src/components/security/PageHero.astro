---
import { Image } from "astro:assets";
import { getImage } from "@/lib/images";
import { cn } from "@/lib/utils";

/**
 * Page hero for the Security and Pricing pages (Figma "Hero", 1376×600 photo card under the header):
 * dark photo with a teal overlay, centred 64px heading, description and one button.
 */
interface Props {
  title: string;
  description: string;
  cta: { label: string; href: string };
  image: string;
  /** Max width of the description (the Figma text boxes differ per page). */
  descriptionClass?: string;
}

const { title, description, cta, image, descriptionClass } = Astro.props;
const lines = title.split("\n");
---

<!-- Full width with a 16/24/32px gutter (1376 at 1440 = Figma, edge to edge at 1920 like Framer).
     The space below is a margin so the section itself is exactly the card. -->
<section class="mb-6 px-4 sm:px-6 lg:mb-8 lg:px-8" aria-labelledby="page-hero-title">
    <div
      class="page-hero relative isolate flex min-h-[360px] items-center justify-center overflow-hidden rounded-card px-5 py-12 sm:min-h-[460px] sm:px-10 lg:h-[600px] lg:py-0"
      data-page-hero
    >
      <Image
        src={getImage(image)}
        alt=""
        widths={[640, 1024, 1376, 1792]}
        sizes="(min-width: 1024px) calc(100vw - 64px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
        loading="eager"
        fetchpriority="high"
        class="page-hero-photo absolute inset-0 -z-20 size-full object-cover"
      />
      <div class="page-hero-overlay absolute inset-x-0 top-0 -z-10 h-[160%]" aria-hidden="true"></div>
      <div class="page-hero-spot pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

      <div class="flex w-full max-w-[760px] flex-col items-center text-center">
        <h1 id="page-hero-title" class="text-display font-medium text-white" data-split="chars">
          {lines.map((line, i) => (i ? [" ", <br />, line] : line))}
        </h1>
        <p class={cn("mt-3 max-w-[574px] text-lead text-white/85", descriptionClass)} data-split="words">{description}</p>
        <a
          href={cta.href}
          class="mt-8 inline-flex min-h-[52px] items-center justify-center rounded-[22px] bg-brand px-6 text-base leading-6 font-medium text-canvas shadow-[0_0_24px_0_rgb(44_103_246/0.45)] transition-[background-color,box-shadow,scale] duration-[250ms,300ms,450ms] ease-[ease,ease,cubic-bezier(0.34,1.56,0.64,1)] hover:scale-[1.02] hover:bg-brand-hover active:scale-[0.97] motion-reduce:hover:scale-100"
        >
          {cta.label}
        </a>
      </div>
    </div>
</section>

<style>
  .page-hero-overlay {
    background: linear-gradient(180deg, rgb(9 20 20 / 0.62) 0%, rgb(19 44 52 / 0.35) 55%, rgb(38 75 81 / 0.38) 100%);
  }
  .page-hero-spot {
    opacity: 0;
    background: radial-gradient(560px circle at var(--mx, 50%) var(--my, 50%), rgb(140 200 230 / 0.14), rgb(110 221 197 / 0.04) 45%, transparent 70%);
    transition: opacity 0.8s ease-out;
  }

  /* Framer starts the hero text once the page has hydrated (~0.3s later than our first paint). */
  #page-hero-title :global(.split-c),
  #page-hero-title ~ p :global(.split-w) {
    transition-delay: calc(var(--d) + 0.25s);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The photo settles in slowly on load, then drifts a few px with the pointer (desktop). */
    .page-hero-photo {
      animation: page-hero-settle 1.8s cubic-bezier(0.22, 1, 0.36, 1) both;
      translate: calc(var(--px, 0) * -16px) calc(var(--py, 0) * -10px);
      transition: scale 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    [data-pointer] .page-hero-photo {
      scale: 1.05;
    }
    [data-pointer] .page-hero-spot {
      opacity: 1;
    }
  }
  @keyframes page-hero-settle {
    from {
      transform: scale(1.08);
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  // Desktop only: a soft light follows the pointer and the photo shifts a few px (eased in rAF).
  const card = document.querySelector<HTMLElement>("[data-page-hero]");
  if (card && !reduceMotion() && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let tx = 0, ty = 0, cx = 0, cy = 0, mx = 0, my = 0, smx = 0, smy = 0, raf = 0;
    const step = () => {
      cx += (tx - cx) * 0.07;
      cy += (ty - cy) * 0.07;
      smx += (mx - smx) * 0.14;
      smy += (my - smy) * 0.14;
      card.style.setProperty("--px", cx.toFixed(4));
      card.style.setProperty("--py", cy.toFixed(4));
      card.style.setProperty("--mx", `${smx.toFixed(1)}px`);
      card.style.setProperty("--my", `${smy.toFixed(1)}px`);
      const still = Math.abs(tx - cx) < 0.001 && Math.abs(ty - cy) < 0.001 && Math.abs(mx - smx) < 0.5 && Math.abs(my - smy) < 0.5;
      raf = still ? 0 : requestAnimationFrame(step);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(step);
    };
    card.addEventListener("pointerenter", (e) => {
      const r = card.getBoundingClientRect();
      smx = mx = e.clientX - r.left;
      smy = my = e.clientY - r.top;
      card.setAttribute("data-pointer", "");
    });
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      tx = (mx / r.width) * 2 - 1;
      ty = (my / r.height) * 2 - 1;
      kick();
    });
    card.addEventListener("pointerleave", () => {
      tx = ty = 0;
      card.removeAttribute("data-pointer");
      kick();
    });
  }
</script>
