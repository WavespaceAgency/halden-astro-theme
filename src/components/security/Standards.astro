---
import Container from "@/components/ui/Container.astro";
import { standards } from "@/config/pages/security";
import SectionIntro from "./SectionIntro.astro";

/** Figma "Standards" (1440×571): heading + five badge cards with a shield mark. */
const s = standards;
---

<section id={s.id} class="py-16 lg:py-24" aria-labelledby="standards-title">
  <Container>
    <SectionIntro id="standards-title" eyebrow={s.eyebrow} title={s.title} titleMuted={s.titleMuted} gap="sm" />
    <ul data-stagger class="mt-10 grid gap-4 sm:grid-cols-6 lg:mt-12 lg:grid-cols-5">
      {
        s.items.map((item) => (
          <li class="lift-card flex flex-col items-center gap-5 rounded-[20px] bg-canvas-2 px-6 py-7 text-center sm:col-span-2 sm:[&:nth-child(n+4)]:col-span-3 lg:col-span-1 lg:[&:nth-child(n+4)]:col-span-1">
            <svg class="badge-mark size-[52px] shrink-0" viewBox="0 0 52 52" fill="none" aria-hidden="true">
              <rect width="52" height="52" rx="26" fill="var(--ink)" />
              <path
                d="M26 15.5 35 19v6.5c0 5.5-4 9.5-9 11-5-1.5-9-5.5-9-11V19l9-3.5Z"
                stroke="var(--sky)"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
              <path d="m22.45 25.2 2.8 2.8 4.7-5" stroke="var(--sky)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex flex-col gap-1">
              <h3 class="text-h4 leading-6 font-medium tracking-[-0.015em] text-ink" data-split="words">{item.title}</h3>
              <p class="text-[13px] leading-[17px] text-muted">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  /* Hover: the badge lifts onto a white card with a soft shadow; the shield gives a small nod. */
  .lift-card {
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0s),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0s),
      translate 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .badge-mark {
    transition: rotate 0.6s cubic-bezier(0.34, 1.45, 0.64, 1), scale 0.6s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  @media (hover: hover) {
    .lift-card:hover {
      translate: 0 -4px;
      background-color: var(--surface);
      box-shadow: 0 2px 4px 0 rgb(50 25 4 / 0.04), 0 18px 40px -8px rgb(50 25 4 / 0.12);
    }
    .lift-card:hover .badge-mark {
      scale: 1.08;
      rotate: -6deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lift-card:hover {
      translate: none;
    }
    .lift-card:hover .badge-mark {
      scale: none;
      rotate: none;
    }
  }
</style>
