---
import { Image } from "astro:assets";
import PlayIcon from "@/components/ui/PlayIcon.astro";
import { getImage } from "@/lib/images";
import { isExternal } from "@/lib/utils";
import { hero } from "@/config/pages/home";
import HeroFlow from "./HeroFlow.astro";

/**
 * Home hero (Figma "V.3 Hero", 1440×1208 incl. header): dark photo card with
 * the two-line heading, animated waveform, buttons and the flow diagram.
 * Full width like Framer: the card keeps 32px side margins at every desktop width; the text
 * sits in a centred 1312px column (1248 at 1440), the flow diagram stays at the card padding.
 * Motion on top of the Framer appear sequence: drifting/breathing colour glows, and on desktop
 * (hover + fine pointer) a soft light that follows the pointer plus a gentle parallax.
 */

/** Waveform bars from Figma: [height, colour]. They pulse in CSS (see <style>). */
const bars: [number, string][] = [
  [4, "#2c67f6"], [8, "#2c67f6"], [14, "#2c67f6"], [10, "#4884f7"], [20, "#4884f7"], [26, "#4884f7"],
  [16, "#64a0f8"], [22, "#64a0f8"], [12, "#6dcde3"], [18, "#6dcde3"], [24, "#6dcde3"], [10, "#6eddc5"],
  [6, "#6eddc5"], [12, "#6eddc5"], [8, "#aadf6f"], [4, "#aadf6f"],
];
---

<section class="hero-section pb-10 sm:pb-16" aria-labelledby="hero-title">
  <div class="w-full px-3 sm:px-6 lg:px-8">
    <div class="relative isolate overflow-hidden rounded-card bg-ink-2 px-5 pt-12 pb-8 sm:px-10 sm:pt-14 lg:pb-[max(2rem,calc(72px*var(--flow-s)))] lg:px-16 lg:pt-16" data-hero-card="">
      <Image
        src={getImage(hero.image)}
        alt=""
        widths={[640, 1024]}
        sizes="calc(100vw - 48px)"
        loading="eager"
        fetchpriority="high"
        class="hero-photo absolute inset-0 -z-20 size-full object-cover"
      />
      <!-- The overlay is split into its gradient layers (same stacking order = same picture) so the glows can drift. -->
      <div class="hero-overlay absolute inset-x-0 -top-[60px] bottom-0 -z-10" aria-hidden="true">
        <span class="hero-layer hero-shade-v"></span>
        <span class="hero-layer hero-glow hero-glow--blue"></span>
        <span class="hero-layer hero-glow hero-glow--violet"></span>
        <span class="hero-layer hero-glow hero-glow--teal"></span>
        <span class="hero-layer hero-shade-h"></span>
      </div>
      <div class="hero-spot absolute inset-0 -z-10" aria-hidden="true"></div>

      <!-- One centred content column (1248px at 1440 = Figma, scaled with the diagram below) for the text and the diagram on wide screens. -->
      <div class="mx-auto lg:max-w-[calc(1248px*var(--flow-s))]">
      <div class="max-w-[760px]">
        <h1 id="hero-title" class="hero-h1 text-display font-medium text-white" data-split="chars">
          {hero.titleStart}{" "}<span class="hero-wave" aria-hidden="true">{bars.map(([h, c], i) => <span style={`--h:${h}px;--c:${c};--i:${i}`} />)}</span>{" "}{hero.titleEnd}{" "}<br class="hidden md:inline" />{hero.titleLine2}
        </h1>
        <p class="mt-5 max-w-[663px] text-lead text-white/82" data-split="words">{hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-3 sm:mt-[35px]">
          <a
            href={hero.primary.href}
            class="hero-btn min-h-[52px] flex-1 rounded-[18px] bg-[#3465e8] px-5 sm:px-6 text-base leading-[21px] shadow-[0_8px_28px_0_rgb(123_175_249/0.45)] hover:scale-[1.02] sm:flex-none"
          >
            {hero.primary.label}
          </a>
          <a
            href={hero.secondary.href}
            {...(isExternal(hero.secondary.href) ? { target: "_blank", rel: "noopener" } : {})}
            class="hero-btn min-h-[52px] px-5 sm:px-6 leading-6 flex-1 rounded-[18px] border border-white/17 bg-white/8 text-base text-canvas backdrop-blur-none hover:bg-white/14 sm:flex-none"
          >
            <PlayIcon />
            {hero.secondary.label}
          </a>
        </div>
      </div>

      <HeroFlow />
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero-card] {
    --flow-s: 0.5;
  }
  /* Space under the card: Figma's 165px only from 1440 up. */
  @media (min-width: 1024px) {
    .hero-section {
      padding-bottom: 96px;
    }
  }
  @media (min-width: 1440px) {
    .hero-section {
      padding-bottom: 165px;
    }
  }
  @media (min-width: 900px) {
    [data-hero-card] {
      --flow-s: 0.6;
    }
  }
  @media (min-width: 1024px) {
    [data-hero-card] {
      --flow-s: 0.66;
    }
  }
  @media (min-width: 1152px) {
    [data-hero-card] {
      --flow-s: 0.76;
    }
  }
  @media (min-width: 1280px) {
    [data-hero-card] {
      --flow-s: 0.85;
    }
  }
  @media (min-width: 1440px) {
    [data-hero-card] {
      --flow-s: 1;
    }
  }
  /* Hero buttons (Figma: 52px high, 18px radius, 16px text) */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 500;
    white-space: nowrap;
    color: #fff;
    transition:
      background-color 0.15s,
      scale 0.15s;
  }
  .hero-photo {
    /* Figma image adjustments: exposure −0.25, contrast +0.15, saturation −0.6 */
    filter: brightness(0.8) contrast(1.15) saturate(0.4);
  }
  .hero-layer {
    position: absolute;
    inset: 0;
  }
  /* Glow layers are 200% of the overlay (−50% each side) so neither the gradients nor the drift
     ever reach their edges (no seams);
     their gradients are converted so they sit exactly where Figma has them. */
  .hero-glow {
    inset: -50%;
  }
  .hero-shade-h {
    background: linear-gradient(90deg, rgb(5 16 30 / 0.55), rgb(5 16 30 / 0.2) 40%, rgb(5 16 30 / 0) 65%);
  }
  .hero-glow--teal {
    background: radial-gradient(17.5% 22.5% at 42.5% 75%, rgb(87 191 179 / 0.35), rgb(87 191 179 / 0.1) 55%, rgb(87 191 179 / 0));
  }
  .hero-glow--violet {
    background: radial-gradient(20% 25% at 64% 72.5%, rgb(118 93 246 / 0.45), rgb(118 93 246 / 0.15) 50%, rgb(118 93 246 / 0));
  }
  .hero-glow--blue {
    background: radial-gradient(22.5% 30% at 71% 31%, rgb(44 103 246 / 0.55), rgb(44 103 246 / 0.2) 50%, rgb(44 103 246 / 0));
  }
  .hero-shade-v {
    background: linear-gradient(180deg, rgb(12 26 47 / 0.55), rgb(12 26 47 / 0.35) 50%, rgb(5 16 30 / 0.6));
  }
  /* Phones: no forced break, balanced lines (3 even lines instead of an orphan). */
  .hero-h1 {
    text-wrap: balance;
  }
  .hero-spot {
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 50%), rgb(100 160 248 / 0.2), rgb(110 221 197 / 0.06) 45%, transparent 70%);
    transition: opacity 0.8s ease-out;
  }

  /* Hero starts a little later, like Framer (its sequence waits for the page to hydrate). */
  #hero-title :global(.split-c),
  #hero-title ~ p :global(.split-w) {
    transition-delay: calc(var(--d) + var(--hero-delay, 0.15s));
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Glows drift and breathe slowly (they start from the Figma position). */
    .hero-glow {
      transform-origin: var(--o);
      will-change: transform, opacity;
      animation:
        var(--drift) var(--t) cubic-bezier(0.45, 0, 0.55, 1) infinite alternate,
        hero-breathe var(--b) cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }
    .hero-glow--blue {
      --o: 71% 31%;
      --drift: hero-drift-blue;
      --t: 16s;
      --b: 6s;
    }
    .hero-glow--violet {
      --o: 64% 72.5%;
      --drift: hero-drift-violet;
      --t: 19s;
      --b: 7.5s;
    }
    .hero-glow--teal {
      --o: 42.5% 75%;
      --drift: hero-drift-teal;
      --t: 14s;
      --b: 5.5s;
    }
    /* Pointer light + parallax (desktop only; set by the script below). */
    .hero-photo {
      translate: calc(var(--px, 0) * -14px) calc(var(--py, 0) * -10px);
      transition: scale 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hero-glow,
    [data-hero-card] :global([data-hero-flow]) {
      translate: calc(var(--px, 0) * var(--pd, 0px)) calc(var(--py, 0) * var(--pd, 0px));
    }
    .hero-glow {
      --pd: 22px;
    }
    [data-hero-card] :global([data-hero-flow]) {
      --pd: 6px;
    }
    [data-hero-card][data-pointer] .hero-photo {
      scale: 1.05;
    }
    [data-hero-card][data-pointer] .hero-spot {
      opacity: 1;
    }
  }
  /* Safety net: the hero copy always shows, even if a script fails or runs late. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) #hero-title:not([data-split-play]),
    :global(html.js) #hero-title ~ p:not([data-split-play]),
    #hero-title:not([data-split-play]) :global(.split-c),
    #hero-title ~ p:not([data-split-play]) :global(.split-w) {
      animation: hero-failsafe 0.4s ease-out 2.5s forwards;
    }
  }
  @keyframes hero-failsafe {
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @keyframes hero-drift-blue {
    to {
      transform: translate(-3%, 3.5%) scale(1.18);
    }
  }
  @keyframes hero-drift-violet {
    to {
      transform: translate(-4.5%, -3%) scale(1.22);
    }
  }
  @keyframes hero-drift-teal {
    to {
      transform: translate(5%, -2.5%) scale(1.15);
    }
  }
  @keyframes hero-breathe {
    to {
      opacity: 0.6;
    }
  }

  /* Waveform between "Patient calls" and "handled" (hidden on phones, like Framer). */
  .hero-wave {
    display: none;
  }
  @media (min-width: 768px) {
    .hero-wave {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      width: 112px;
      height: 28px;
      margin: 0 0.06em 0 0.35em;
      vertical-align: 0.12em;
      scale: var(--wave-s, 1);
    }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .hero-wave {
      --wave-s: 0.8;
      margin-inline: -0.1em -0.25em;
    }
  }
  .hero-wave > span {
    width: 3px;
    height: var(--h);
    flex: none;
    border-radius: 2px;
    background: var(--c);
    box-shadow: 0 0 12px rgb(100 160 248 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-wave > span {
      animation: hero-bar calc(0.9s + mod(var(--i) * 0.37s, 0.7s)) ease-in-out calc(var(--i) * -0.23s) infinite alternate;
    }
  }
  @keyframes hero-bar {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  // Start the hero text right away (do not wait for the scroll observer).
  const heroText = document.querySelectorAll<HTMLElement>("#hero-title, #hero-title ~ p[data-split]");
  let tries = 0;
  const kickText = () => {
    heroText.forEach((el) => el.hasAttribute("data-split-ready") && el.setAttribute("data-split-play", ""));
    if (++tries < 60 && [...heroText].some((el) => !el.hasAttribute("data-split-play"))) requestAnimationFrame(kickText);
  };
  if (!reduceMotion()) requestAnimationFrame(kickText);

  // Desktop only: a soft light follows the pointer and the photo/glows shift a few px (eased in rAF).
  const card = document.querySelector<HTMLElement>("[data-hero-card]");
  if (card && !reduceMotion() && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let tx = 0, ty = 0, cx = 0, cy = 0, mx = 0, my = 0, smx = 0, smy = 0, raf = 0;
    const step = () => {
      cx += (tx - cx) * 0.07;
      cy += (ty - cy) * 0.07;
      smx += (mx - smx) * 0.14;
      smy += (my - smy) * 0.14;
      card.style.setProperty("--px", cx.toFixed(4));
      card.style.setProperty("--py", cy.toFixed(4));
      card.style.setProperty("--mx", `${smx.toFixed(1)}px`);
      card.style.setProperty("--my", `${smy.toFixed(1)}px`);
      const still = Math.abs(tx - cx) < 0.001 && Math.abs(ty - cy) < 0.001 && Math.abs(mx - smx) < 0.5 && Math.abs(my - smy) < 0.5;
      raf = still ? 0 : requestAnimationFrame(step);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(step);
    };
    card.addEventListener("pointerenter", (e) => {
      const r = card.getBoundingClientRect();
      smx = mx = e.clientX - r.left;
      smy = my = e.clientY - r.top;
      card.setAttribute("data-pointer", "");
    });
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      tx = (mx / r.width) * 2 - 1;
      ty = (my / r.height) * 2 - 1;
      kick();
    });
    card.addEventListener("pointerleave", () => {
      tx = ty = 0;
      card.removeAttribute("data-pointer");
      kick();
    });
  }
</script>
