---
import { Image } from "astro:assets";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { results as r } from "@/config/pages/home";
import { getImage } from "@/lib/images";

/**
 * "Results" band (Figma "Stats — bento", 1440×1070): blue→violet gradient panel with a
 * testimonial and four numbers. Numbers count up via data-count (src/scripts/motion.ts).
 */
const corners = ["top-6 left-6", "top-6 right-6", "bottom-6 left-6", "right-6 bottom-6"];
---

<section class="results rounded-[24px] px-4 py-16 sm:px-6 md:py-24 lg:rounded-[32px] lg:px-12 lg:py-[120px] xl:px-24" aria-labelledby="results-title">
  <div class="mx-auto max-w-[1312px]">
    <div class="flex flex-col items-center text-center">
      <Eyebrow {...r.eyebrow} theme="light" />
      <h2 id="results-title" class="mt-4 text-h1 font-medium whitespace-pre-line text-balance text-white" data-split="chars">
        {r.title}<span class="text-white/78">{r.titleMuted}</span>
      </h2>
    </div>

    <div class="mt-10 border border-[#8884c6] lg:mt-14">
      <figure class="relative flex flex-col gap-10 px-5 py-8 sm:px-10 sm:py-12 md:flex-row md:items-end md:justify-between md:gap-12 lg:gap-16 lg:pt-14 lg:pr-14 lg:pb-14 lg:pl-16">
        {corners.map((c) => <span class={`absolute hidden size-2.5 bg-[#7baff9] md:block ${c}`} aria-hidden="true" />)}
        <div class="max-w-[784px] md:mb-0 lg:pb-0">
          <blockquote class="text-[22px] leading-[1.27] tracking-[-0.025em] text-white sm:text-[28px] lg:text-[36px] lg:leading-[1.18]" data-split="words">
            <p>{r.quote.before}<strong class="font-medium text-sky-soft underline decoration-2 underline-offset-[6px]">{r.quote.highlight}</strong>{r.quote.after}</p>
          </blockquote>
          <figcaption class="mt-8 lg:mt-14">
            <span class="block text-lg leading-[23px] font-medium text-white">{r.quote.name}</span>
            <span class="mt-1 block text-base leading-[21px] text-[#f1f1f1]">{r.quote.role}</span>
          </figcaption>
        </div>
        <Image
          src={getImage(r.quote.image)}
          alt={r.quote.imageAlt}
          widths={[320, 520, 640]}
          sizes="(min-width: 768px) 260px, 100vw"
          class="res-photo aspect-[260/320] w-full shrink-0 rounded-[20px] object-cover md:w-[220px] lg:w-[260px]"
        />
      </figure>

      <dl class="grid grid-cols-2 border-t border-white/30 md:grid-cols-4">
        {
          r.stats.map((s, i) => (
            <div class:list={["res-stat flex flex-col-reverse items-center justify-center gap-3 px-3 py-8 text-center sm:px-8", i % 2 === 1 && "border-l border-white/30", i > 1 && "border-t border-white/30 md:border-t-0", i === 2 && "md:border-l"]}>
              <dt class:list={["text-[15px] leading-[22px] whitespace-pre-line", i === 3 ? "text-[#dde8fd]" : "text-[#f1f1f1]"]}>{s.label}</dt>
              <dd class="text-[36px] leading-[1.3] font-medium tracking-[-0.03em] text-white lg:text-[44px]" data-count={s.count ? s.value : undefined}>
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Hover: the portrait lifts and glows, stat cells light up. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .res-photo {
      transition:
        translate 0.5s cubic-bezier(0.34, 1.45, 0.64, 1),
        box-shadow 0.4s ease-out;
    }
    figure:hover .res-photo {
      translate: 0 -6px;
      box-shadow:
        0 24px 48px -12px rgb(10 14 60 / 0.45),
        0 0 0 1px rgb(255 255 255 / 0.25);
    }
    .res-stat {
      transition: background-color 0.3s ease-out;
    }
    .res-stat > dd {
      transition: translate 0.45s cubic-bezier(0.34, 1.45, 0.64, 1);
    }
    .res-stat:hover {
      background-color: rgb(255 255 255 / 0.06);
    }
    .res-stat:hover > dd {
      translate: 0 -3px;
    }
  }
  .results {
    background: linear-gradient(180deg, #2c4ebd, #414fb9 45%, #5850ae 75%, #7457a3);
  }
</style>
