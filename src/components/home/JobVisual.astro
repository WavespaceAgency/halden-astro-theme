---
import { Image } from "astro:assets";
import { jobs, type PillTone } from "@/config/pages/home";
import { getImage } from "@/lib/images";

/**
 * The four "How it works" mock-ups (Figma "How it works / Job" variants), drawn at
 * 748×383 and scaled by the parent. Elements with data-ji slide in and data-jp pills
 * pop in when their job becomes active (see HowItWorks.astro).
 */
interface Props {
  id: string;
}
const { id } = Astro.props;
const a = jobs.answer;
const s = jobs.schedule;
const v = jobs.verify;
const f = jobs.followUp;

const pill: Record<PillTone, string> = {
  blue: "bg-[#ecf3fe] text-brand-deep",
  sky: "bg-sky-soft text-ink-2",
  mint: "bg-[#dff5f1] text-[#316e60]",
  violet: "bg-[#f0ebfd] text-[#563dbd]",
  grey: "bg-[#f3f4f6] text-[#3f464d]",
};
const glass = "absolute rounded-panel border border-ink-2/7 bg-white/92 shadow-[0_1px_2px_0_rgb(12_26_47/0.05),0_12px_32px_0_rgb(12_26_47/0.07)]";
const pillBase = "shrink-0 rounded-full px-2.5 py-1 text-xs leading-4 font-medium";
const conv = a.conversations;
const convPos = [
  [412, 42],
  [420, 152],
  [420, 262],
];
const H = "M35.808 19A16.808 16.808 0 1 1 2.192 19a16.808 16.808 0 0 1 33.616 0ZM12.423 10.961v16.077M25.577 10.961v16.077M12.423 19h13.154";
const liveBars = [4, 9, 14, 8, 16, 11, 6];
---

<div class="relative h-[383px] w-[748px]">
  {
    id === "answer" && (
      <>
        <svg class="absolute inset-0" width="748" height="383" viewBox="0 0 748 383" fill="none" stroke-linecap="round">
          <path d="M72 88C150 88 170 192 236 192M316 192C366 192 370 81 420 81" stroke="#0C1A2F" stroke-width="1.6" class="job-flow" />
          <path d="M72 192H236M72 296C150 296 170 192 236 192M316 192C366 192 370 191 420 191M316 192C366 192 370 301 420 301" stroke="#626D76" stroke-width="1.2" stroke-dasharray="1 6" />
        </svg>
        {a.channels.map((label, i) => (
          <div class="absolute left-6 flex w-12 flex-col items-center gap-1.5" style={`top:${64 + i * 104}px`} data-ji>
            <span class:list={["flex size-12 items-center justify-center rounded-full shadow-[0_1px_2px_0_rgb(50_25_4/0.05),0_10px_28px_0_rgb(50_25_4/0.07)]", i === 0 ? "bg-brand" : "bg-sky-mist opacity-55"]}>
              <svg class="size-12" viewBox="28 18 48 48" fill="none" stroke={i === 0 ? "#fff" : "#0C1A2F"} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                {i === 0 && <path d="M46.167 34.916H49.5l1.5 3.75-2 1.334a8.58 8.58 0 0 0 4.583 4.583l1.334-2 3.75 1.5v3.333a1.25 1.25 0 0 1-1.25 1.25 13.75 13.75 0 0 1-12.5-12.5 1.25 1.25 0 0 1 1.25-1.25Z" />}
                {i === 1 && <path d="M45.333 36.166h13.334v9.167H49.5l-4.167 3.333v-12.5Z" />}
                {i === 2 && <path d="M59.083 42a7.083 7.083 0 1 1-14.166 0 7.083 7.083 0 0 1 14.166 0ZM44.917 42h14.166M52 34.916c2.083 2.167 2.083 12 0 14.167-2.083-2.167-2.083-12 0-14.167Z" />}
              </svg>
            </span>
            <span class:list={["text-[10px] leading-[13px] font-bold tracking-[0.06em] whitespace-nowrap uppercase", i === 0 ? "text-ink-2" : "text-[#4f5962]"]}>{label}</span>
          </div>
        ))}
        <div class="absolute top-[152px] left-[236px] flex size-20 items-center justify-center rounded-[24px] bg-[radial-gradient(circle,#fff_35%,#dfebfd)] shadow-[0_1px_2px_0_rgb(50_25_4/0.05),0_10px_28px_0_rgb(50_25_4/0.07)]" data-jp>
          <svg class="size-[38px]" viewBox="0 0 38 38" fill="none" stroke="#071A31" stroke-width="2.338" stroke-linecap="round"><path d={H} /></svg>
        </div>
        <div class="absolute top-[246px] left-[236px] flex h-[26px] w-20 items-center gap-1.5 rounded-full bg-white px-2.5 shadow-[0_1px_2px_0_rgb(50_25_4/0.05),0_10px_28px_0_rgb(50_25_4/0.07)]" data-jp>
          <span class="job-bars flex h-4 items-center gap-0.5">{liveBars.map((h, i) => <span class="w-[3px] rounded-sm bg-ink-2" style={`height:${h}px;--i:${i}`} />)}</span>
          <span class="text-[11px] leading-[14px] font-medium text-ink-2">{a.live}</span>
        </div>
        <div class="absolute top-1.5 left-[420px] flex w-[316px] justify-between text-[13px] leading-[17px] font-medium text-ink-2" data-ji>
          <span>{a.header.title}</span>
          <span>{a.header.meta}</span>
        </div>
        {conv.map((c, i) => (
          <div class="absolute flex h-[78px] w-[316px] items-center gap-3 rounded-panel bg-white px-4" style={`left:${convPos[i][0]}px;top:${convPos[i][1]}px`} data-ji>
            <Image src={getImage(c.avatar)} alt="" width={40} height={40} densities={[1, 2]} class="size-10 shrink-0 rounded-full object-cover" />
            <span class="min-w-0 flex-1">
              <span class="block text-[15px] leading-5 font-medium tracking-[-0.01em] text-ink-2">{c.name}</span>
              <span class:list={["mt-0.5 block text-[13px] leading-[17px]", i === 0 ? "text-[#4f5962]" : "text-[#303a43]"]}>{c.text}</span>
            </span>
            <span class:list={[pillBase, i === 0 ? "bg-sky-soft text-ink-2" : "bg-[#f1f6fe] text-ink-2"]} data-jp>{c.status}</span>
          </div>
        ))}
      </>
    )
  }

  {
    id === "schedule" && (
      <>
        <div class={`${glass} top-4 left-0 w-[440px] px-5 pt-[18px] pb-5`} data-ji>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2 text-sm leading-[18px] font-medium text-ink-2">
              <Image src={getImage(s.doctorAvatar)} alt="" width={22} height={22} densities={[1, 2]} class="size-[22px] rounded-full border border-ink-2/6 object-cover" />
              {s.calendar}
            </span>
            <span class="flex items-center gap-1.5 rounded-full bg-[#e7f5f0] px-2 py-[3px] font-mono text-xs leading-4 font-medium text-[#2f6f61]">
              <span class="size-1.5 rounded-full bg-[#3e887e]" />
              {s.synced}
            </span>
          </div>
          <div class="mt-3.5 grid grid-cols-5 gap-2">
            {s.days.map((day, d) => (
              <div class="flex flex-col gap-1.5">
                <span class="font-mono text-[11px] leading-[14px] font-medium tracking-[0.06em] text-subtle uppercase">{day}</span>
                {s.times.map((t, i) => {
                  const state = s.slots[d][i];
                  return (
                    <span
                      class:list={[
                        "rounded-md px-2 font-mono text-[11px] leading-[14px] font-medium",
                        state === 0 && "bg-[#f6f7f9] py-[7px] text-[#656e78]",
                        state === 1 && "border border-[#c9dbfa] bg-white py-[7px] text-[#2457d6]",
                        state === 2 && "bg-brand py-[7px] text-white shadow-[0_4px_10px_0_rgb(43_102_245/0.28)]",
                      ]}
                      data-jp={state === 2 ? "" : undefined}
                    >
                      {t}
                    </span>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
        <div class={`${glass} top-10 left-[480px] flex w-[258px] items-center gap-2 py-2.5 pr-3.5 pl-3`} data-ji>
          <Image src={getImage(s.patientAvatar)} alt="" width={22} height={22} densities={[1, 2]} class="size-[22px] rounded-full border border-ink-2/6 object-cover" />
          <span class="text-[13px] leading-[17px] text-ink-2">{s.quote}</span>
        </div>
        <div class={`${glass} top-[210px] left-[420px] flex w-[329px] items-center gap-3 py-3.5 pr-4 pl-3.5`} data-ji>
          <Image src={getImage(s.patientAvatar)} alt="" width={32} height={32} densities={[1, 2]} class="size-8 rounded-full border-[1.5px] border-white object-cover" />
          <span class="min-w-0 flex-1">
            <span class="block text-sm leading-[18px] font-medium text-ink-2">{s.booked.title}</span>
            <span class="mt-0.5 block text-xs leading-4 text-subtle">{s.booked.meta}</span>
          </span>
          <span class={`${pillBase} ${pill.mint}`} data-jp>{s.booked.status}</span>
        </div>
        <div class={`${glass} top-[300px] left-[470px] flex w-[266px] items-center gap-2 px-3.5 py-3`} data-ji>
          <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="none"><rect width="16" height="16" rx="8" fill="#3E887E" /><path d="m3.5 8.25 3 3 6-6.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="text-xs leading-4 font-medium whitespace-nowrap text-[#3f464d]">{s.sms}</span>
        </div>
      </>
    )
  }

  {
    id === "verify" && (
      <>
        <div class={`${glass} top-2 left-[164px] w-[420px] px-[22px] pt-5 pb-[22px]`} data-ji>
          <div class="flex items-center gap-3">
            <Image src={getImage(v.patient.avatar)} alt="" width={32} height={32} densities={[1, 2]} class="size-8 rounded-full border-[1.5px] border-white object-cover" />
            <span class="min-w-0 flex-1">
              <span class="block text-sm leading-[18px] font-medium text-ink-2">{v.patient.name}</span>
              <span class="mt-0.5 block text-xs leading-4 text-subtle">{v.patient.plan}</span>
            </span>
            <span class={`${pillBase} ${pill.mint}`} data-jp>{v.patient.status}</span>
          </div>
          <div class="my-4 h-px bg-ink-2/8" />
          <ul class="flex flex-col gap-4">
            {v.rows.map((row) => (
              <li class="flex items-center gap-3 text-[13px] leading-[17px]" data-ji>
                <svg class="size-[18px] shrink-0" viewBox="0 0 18 18" fill="none"><rect width="18" height="18" rx="9" fill="#E3F3EE" /><path d="m4.5 9.25 3 3 6-6.5" stroke="#2F7A6F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="flex-1 text-[#3f464d]">{row.label}</span>
                <span class="font-medium text-ink-2">{row.value}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class={`${glass} top-[60px] left-5 flex items-center gap-2 px-3.5 py-2.5`} data-ji>
          <span class="size-[7px] rounded-full bg-[#3e887e]" />
          <span class="text-[13px] leading-[17px] font-medium whitespace-nowrap text-ink-2">{v.timer}</span>
        </div>
        <div class={`${glass} top-[150px] left-[600px] flex items-center gap-2 px-3.5 py-2.5`} data-ji>
          <span class="font-mono text-xs leading-4 font-medium whitespace-nowrap text-subtle">{v.payer.label}</span>
          <span class={`${pillBase} ${pill.blue}`} data-jp>{v.payer.status}</span>
        </div>
        <div class={`${glass} top-[300px] left-[30px] flex items-center gap-2 py-2.5 pr-3.5 pl-[15px]`} data-ji>
          <Image src={getImage(v.patient.avatar)} alt="" width={20} height={20} densities={[1, 2]} class="size-5 rounded-full border border-ink-2/6 object-cover" />
          <span class="ml-1 text-[13px] leading-[17px] font-medium whitespace-nowrap text-[#3f464d]">{v.note}</span>
        </div>
      </>
    )
  }

  {
    id === "follow-up" && (
      <>
        <ul class="absolute top-3 left-6 flex w-[400px] flex-col gap-3.5">
          {f.timeline.map((item) => (
            <li class={`${glass} relative flex items-center gap-3 px-3.5 py-3`} data-ji>
              <Image src={getImage(item.avatar)} alt="" width={32} height={32} densities={[1, 2]} class="size-8 shrink-0 rounded-full border border-ink-2/6 object-cover" />
              <span class="min-w-0 flex-1">
                <span class="block font-mono text-[10px] leading-[13px] font-medium tracking-[0.06em] text-subtle uppercase">{item.tag}</span>
                <span class="mt-[3px] block text-sm leading-[18px] font-medium text-ink-2">{item.title}</span>
                <span class="mt-[3px] block text-xs leading-4 text-subtle">{item.text}</span>
              </span>
              <span class={`${pillBase} ${pill[item.tone]}`} data-jp>{item.status}</span>
            </li>
          ))}
        </ul>
        <div class="absolute top-5 left-[500px] h-[340px] w-[220px] rounded-[32px] border-[6px] border-white/60 bg-ink-2 p-0 shadow-[0_1px_2px_0_rgb(12_26_47/0.05),0_12px_32px_0_rgb(12_26_47/0.07)]" data-ji>
          <div class="flex h-full flex-col gap-2.5 rounded-[26px] bg-[#f5f7fb] px-4 pt-11 pb-4">
            <span class="font-mono text-[11px] leading-[14px] font-medium text-subtle">{f.phone.sender}</span>
            <span class="w-40 rounded-panel rounded-bl-[4px] bg-white px-3 py-2.5 text-xs leading-[17px] text-ink-2" data-ji>{f.phone.incoming}</span>
            <span class="self-end rounded-[14px_14px_4px_14px] bg-brand px-3.5 py-[7px] text-xs leading-4 font-medium text-white" data-ji>{f.phone.reply}</span>
            <span class="w-40 rounded-panel rounded-bl-[4px] bg-white px-3 py-2.5 text-xs leading-4 font-medium text-[#316e60]" data-ji>{f.phone.confirmed}</span>
          </div>
        </div>
      </>
    )
  }
</div>
