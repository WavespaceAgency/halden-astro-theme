---
import { hero } from "@/config/pages/home";

/**
 * Flow diagram in the hero: inputs → three steps → outputs, plus the live call card.
 * Drawn at the Figma size (1248×390) and scaled down with --flow-s (set on the hero card)
 * on laptops and tablets. Hidden on phones, like the Framer site.
 * Appear sequence and loops copy the Framer timings (see <style>).
 */
const f = hero.flow;
const rows = [48, 96, 144];
const stepX = [236, 506, 776];

/** Framer delays (s) for each element. */
const inDelay = [0.3, 0.38, 0.46];
const stepDelay = [0.62, 0.74, 0.86];
const outDelay = [0.98, 1.06, 1.14];
---

<div class="hero-flow relative mt-[calc(132px*var(--flow-s))] hidden h-[calc(390px*var(--flow-s))] md:block" role="img" aria-label={f.label} data-hero-flow>
  <div class="absolute top-0 left-0 h-[390px] w-[1248px] origin-top-left scale-(--flow-s)" aria-hidden="true">
    <svg class="flow-in absolute inset-0" style="--d:0.5s" width="1248" height="390" viewBox="0 0 1248 390" fill="none" data-kind="fade">
      <g stroke="#64A0F8" stroke-width="1.4">
        <path d="M200 66C232.727 66 203.273 115 236 115" />
        <path d="M200 114C232.727 114 203.273 115 236 115" />
        <path d="M200 162C232.727 162 203.273 115 236 115" />
      </g>
      <path d="M456 115H506M726 115H776" stroke="#fff" stroke-opacity="0.35" stroke-width="1.2" />
      <g stroke="#AADF6F" stroke-width="1.4">
        <path d="M996 115C1041 115 1023 66 1068 66" />
        <path d="M996 115C1041 115 1023 114 1068 114" />
        <path d="M996 115C1041 115 1023 162 1068 162" />
        <path d="M266 6v90" stroke-dasharray="2 4" stroke-dashoffset="-1" />
      </g>
      <path d="M266 134v82" stroke="#6EDDC5" stroke-width="1.4" stroke-dasharray="1.95 3.9" />
      <defs>
        <linearGradient id="flow-dot" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#7BAFF9" />
          <stop offset="1" stop-color="#C8DEFB" />
        </linearGradient>
      </defs>
      <circle cx="1068" cy="66" r="2.5" fill="url(#flow-dot)" />
      <circle cx="1068" cy="114" r="2.5" fill="url(#flow-dot)" />
      <circle cx="1068" cy="162" r="2.5" fill="url(#flow-dot)" />
    </svg>

    <p class="flow-in absolute top-0 left-[276px] text-xs leading-[16.8px] whitespace-pre-line text-mint" style="--d:1.05s;--from:translateY(6px)" data-kind="tween">{f.note}</p>

    {
      f.inputs.map((item, i) => (
        <div class="flow-in flow-node absolute left-0 h-9 w-[200px]" style={`top:${rows[i]}px;--d:${inDelay[i]}s;--from:translateX(-16px)`}>
          <svg class="size-3.5 shrink-0" viewBox="0 0 14 14" fill="none" stroke="#64A0F8" stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg>
          {item.label}
        </div>
      ))
    }

    {
      f.steps.map((item, i) => (
        <div class="flow-in absolute top-24 h-[38px] w-[220px]" style={`left:${stepX[i]}px;--d:${stepDelay[i]}s;--from:scale(0.92)`} data-kind="pop">
          <div class:list={["flow-node size-full", i === 0 && "flow-node--active"]}>
            <svg class="size-3.5 shrink-0" viewBox="0 0 14 14" fill="none" stroke={i === 0 ? "#6EDDC5" : "#A28CF8"} stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg>
            {item.label}
          </div>
        </div>
      ))
    }

    {
      f.outputs.map((item, i) => (
        <div class="flow-in flow-node absolute left-[1068px] h-9 w-[180px]" style={`top:${rows[i]}px;--d:${outDelay[i]}s;--from:translateX(16px)`}>
          <svg class="size-3.5 shrink-0" viewBox="0 0 14 14" fill="none" stroke="#AADF6F" stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg>
          {item.label}
        </div>
      ))
    }

    <div class="flow-in flow-glass absolute top-[216px] left-[236px] w-[300px] rounded-xl px-4 pt-3.5 pb-3.5" style="--d:1.25s;--from:translateY(24px) scale(0.96)" data-kind="card">
      <div class="flex items-center gap-2.5">
        <svg class="size-8 shrink-0 overflow-visible" viewBox="0 0 32 32" fill="none">
          <circle cx="16" cy="16" r="16" fill="#2C67F6" />
          <path d="M12.923 12.308v7.384M19.077 12.308v7.384M12.923 16h6.154" stroke="#fff" stroke-width="1.723" stroke-linecap="round" />
          <circle cx="28" cy="28" r="6" fill="#fff" />
          <circle cx="28" cy="28" r="3" fill="#AADF6F" />
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-[13px] leading-[17px] text-white">{f.call.name}</p>
          <p class="mt-0.5 text-xs leading-4 text-white/77">{f.call.status}</p>
        </div>
        <span class="flow-live font-mono text-[11px] leading-[14px] font-medium text-lime">{f.call.live}</span>
      </div>
      <p class="flow-in mt-3 rounded-[12px_12px_12px_4px] bg-[#c6b9fa] px-[13px] py-[11px] text-sm leading-[19.6px] text-ink-2" style="--d:1.55s;--from:translateY(8px) scale(0.97)" data-kind="pop">
        {f.call.message}
      </p>
      <div class="mt-2 flex gap-1.5">
        {f.call.replies.map((r) => <span class="rounded-full border border-white/25 px-2.5 py-[5px] text-xs leading-4 text-white">{r}</span>)}
      </div>
    </div>
  </div>
</div>

<style>
  .flow-node {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline: 12px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 17px;
    color: #fff;
  }
  .flow-node,
  .flow-glass {
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.28);
    box-shadow: 0 8px 24px 0 rgb(0 0 0 / 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .flow-node--active {
    background: rgb(110 221 197 / 0.18);
    border-color: #6eddc5;
    box-shadow: 0 0 20px 0 rgb(110 221 197 / 0.5);
    backdrop-filter: none;
  }

  /* Appear sequence (Framer: springs, bounce 0.12–0.25). Start state only with JS + motion allowed. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-hero-flow]:not([data-play]) .flow-in {
      opacity: 0;
      transform: var(--from, none);
    }
    .flow-in {
      transition:
        opacity 0.5s ease-out var(--d, 0s),
        transform 0.7s cubic-bezier(0.25, 1.12, 0.5, 1) var(--d, 0s);
    }
    .flow-in[data-kind="pop"] {
      transition-timing-function: ease-out, cubic-bezier(0.3, 1.35, 0.5, 1);
    }
    .flow-in[data-kind="card"] {
      transition-duration: 0.6s, 0.8s;
      transition-timing-function: ease-out, cubic-bezier(0.3, 1.25, 0.5, 1);
    }
    .flow-in[data-kind="fade"],
    .flow-in[data-kind="tween"] {
      transition-duration: 0.9s;
      transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    .flow-in[data-kind="tween"] {
      transition-duration: 0.6s;
    }
    /* Loops once visible: the triage step breathes, the LIVE label blinks. */
    [data-play] .flow-node--active {
      animation: flow-breathe 1.8s cubic-bezier(0.45, 0, 0.55, 1) 1.4s infinite alternate;
    }
    [data-play] .flow-live {
      animation: flow-blink 1.1s cubic-bezier(0.45, 0, 0.55, 1) 2s infinite alternate;
    }
  }
  @keyframes flow-breathe {
    to {
      transform: scale(1.035);
    }
  }
  @keyframes flow-blink {
    to {
      opacity: 0.45;
    }
  }
</style>

<script>
  // Start the appear sequence when 30% of the diagram is in view (Framer threshold 0.3).
  document.querySelectorAll<HTMLElement>("[data-hero-flow]").forEach((el) => {
    if (!("IntersectionObserver" in window)) return el.setAttribute("data-play", "");
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        el.setAttribute("data-play", "");
        io.disconnect();
      },
      { threshold: 0.3 },
    );
    io.observe(el);
  });
</script>
