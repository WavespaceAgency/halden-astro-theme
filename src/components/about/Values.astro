---
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SplitText from "./SplitText.astro";
import { values } from "@/config/pages/about";

/**
 * "Our values" (Figma "Our values", 1440×687): heading + four cards with an icon tile.
 * Motion (Framer): heading letters pop in, card titles and texts un-blur word by word.
 * Hover: the card lifts, its shadow softens and the icon tile tilts.
 */
---

<section class="py-20 sm:py-24 lg:py-[140px]">
  <Container>
    <div class="flex flex-col items-start">
      <Eyebrow {...values.eyebrow} class="mb-4" />
      <SplitText
        as="h2"
        mode="chars"
        class="text-h1 font-medium tracking-[-0.0375em] text-balance text-ink"
        text={[{ text: values.title }, { text: values.titleMuted, class: "text-muted" }]}
      />
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        values.items.map((item) => (
          <li class="value-card flex min-h-[200px] flex-col justify-between gap-14 rounded-card border border-ink-2/10 bg-surface p-5 sm:p-7 lg:min-h-[248px]">
            <svg class="value-icon size-12 shrink-0" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <rect width="48" height="48" rx="14" fill={item.tile} />
              <path d={item.icon} stroke="#0c1a2f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <SplitText as="h3" text={item.title} class="text-[22px] leading-[1.2] font-medium tracking-[-0.015em] text-ink-2" />
              <SplitText text={item.text} class="mt-1 text-base leading-[26px] text-body" />
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .value-card {
    transition:
      transform 0.5s cubic-bezier(0.34, 1.45, 0.64, 1),
      box-shadow 0.5s ease,
      border-color 0.5s ease;
  }
  .value-icon {
    transition: transform 0.5s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .value-card:hover {
      transform: translateY(-4px);
      border-color: rgb(12 26 47 / 0.06);
      box-shadow: 0 24px 48px -20px rgb(12 26 47 / 0.18);
    }
    .value-card:hover .value-icon {
      transform: rotate(-6deg) scale(1.06);
    }
  }
</style>
