---
import Button from "@/components/ui/Button.astro";
import PlayIcon from "@/components/ui/PlayIcon.astro";
import SplitText from "./SplitText.astro";
import { hero } from "@/config/pages/about";
import { isExternal } from "@/lib/utils";

const demoTarget = isExternal(hero.secondary.href) ? { target: "_blank", rel: "noopener" } : {};

/**
 * About hero (Figma "Hero / Content", 1440×700): centred two-tone heading on a soft
 * teal / lime / blue mesh. Letters pop in, the paragraph words un-blur (Framer text effects and timings).
 * Extra: two soft glows drift slowly and a light follows the pointer (hover devices, motion allowed).
 */
---

<section class="about-hero relative isolate overflow-hidden" data-about-hero>
  <div class="hero-fx pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <span class="drift drift-a"></span>
    <span class="drift drift-b"></span>
    <span class="pointer-light"></span>
  </div>
  <div class="mx-auto flex max-w-[928px] flex-col items-start px-4 pt-14 pb-20 text-left sm:items-center sm:text-center sm:px-6 sm:pt-24 sm:pb-28 lg:px-6 lg:py-[176px]">
    <SplitText
      as="h1"
      mode="chars"
      trigger="load"
      delay={0.15}
      stagger={0.03}
      class="text-[clamp(2.75rem,1.78rem+4.13vw,5.5rem)] leading-[1.02] font-normal tracking-[-0.045em] text-subtle lg:tracking-[-0.055em]"
      text={[
        { text: hero.titleMuted },
        { text: hero.title, class: "font-medium text-ink-2", break: true },
      ]}
    />
    <SplitText
      text={hero.description}
      mode="words"
      trigger="load"
      delay={0.3}
      stagger={0.025}
      class="mt-5 max-w-[670px] text-lg leading-[30px] text-body sm:text-xl sm:leading-8"
    />
    <div class="hero-reveal mt-8 flex w-full flex-wrap justify-start gap-3 sm:justify-center max-sm:grid max-sm:grid-cols-2" style="--delay: 0.35s">
      <Button href={hero.primary.href} size="xl" class="shadow-none">{hero.primary.label}</Button>
      <Button href={hero.secondary.href} {...demoTarget} variant="outline" size="xl" class="rounded-[18px] border-ink-2/25 bg-white/20 text-ink hover:bg-white/50">
        <PlayIcon />
        {hero.secondary.label}
      </Button>
    </div>
  </div>
</section>

<style>
  /* Figma mesh: five radial glows over a pale mint base (top layer first). */
  .about-hero {
    background:
      radial-gradient(42% 42% at 50% 48%, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.35) 60%, rgb(255 255 255 / 0)),
      radial-gradient(45% 75% at 0% 100%, rgb(123 175 249), rgb(158 197 250 / 0.7) 45%, rgb(200 222 251 / 0)),
      radial-gradient(50% 60% at 55% 105%, rgb(127 211 203), rgb(171 228 221 / 0.6) 50%, rgb(208 240 234 / 0)),
      radial-gradient(45% 70% at 0% 0%, rgb(156 225 222), rgb(190 234 230 / 0.7) 50%, rgb(221 243 239 / 0)),
      radial-gradient(55% 90% at 100% 35%, rgb(224 238 160), rgb(232 243 194 / 0.75) 50%, rgb(240 247 222 / 0)),
      #ecf7f1;
  }
  .hero-fx > span {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
  }
  .drift {
    filter: blur(70px);
    will-change: transform;
  }
  .drift-a {
    top: -12%;
    left: 8%;
    width: 46%;
    height: 70%;
    background: rgb(156 225 222 / 0.55);
  }
  .drift-b {
    right: -6%;
    bottom: -20%;
    width: 44%;
    height: 72%;
    background: rgb(224 238 160 / 0.6);
  }
  .pointer-light {
    top: 0;
    left: 0;
    width: 640px;
    height: 640px;
    margin: -320px 0 0 -320px;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0));
    transform: translate3d(var(--px, 50vw), var(--py, 50%), 0);
    transition: opacity 0.6s ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .drift {
      opacity: 1;
    }
    .drift-a {
      animation: drift-a 16s ease-in-out infinite alternate;
    }
    .drift-b {
      animation: drift-b 19s ease-in-out infinite alternate;
    }
    .about-hero[data-lit] .pointer-light {
      opacity: 1;
    }
  }
  @keyframes drift-a {
    to {
      transform: translate3d(14%, 10%, 0) scale(1.12);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate3d(-16%, -8%, 0) scale(0.92);
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  // A soft light follows the pointer over the hero (mouse/pen only, motion allowed).
  document.querySelectorAll<HTMLElement>("[data-about-hero]").forEach((hero) => {
    if (reduceMotion() || !window.matchMedia("(hover: hover)").matches) return;
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let raf = 0;
    const step = () => {
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      hero.style.setProperty("--px", `${x.toFixed(1)}px`);
      hero.style.setProperty("--py", `${y.toFixed(1)}px`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
    };
    hero.addEventListener("pointerenter", (e) => {
      const r = hero.getBoundingClientRect();
      x = tx = e.clientX - r.left;
      y = ty = e.clientY - r.top;
      step();
      hero.setAttribute("data-lit", "");
    });
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (!raf) raf = requestAnimationFrame(step);
    });
    hero.addEventListener("pointerleave", () => hero.removeAttribute("data-lit"));
  });
</script>
