---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SplitText from "./SplitText.astro";
import { press } from "@/config/pages/about";
import { formatDate, getPosts } from "@/lib/content";

/**
 * "Halden in the news" (Figma "Press", 1440×969): the newest blog posts, three per page,
 * with round page buttons (shown when there is more than one page and JavaScript runs).
 * Motion (Framer): heading and card titles pop in letter by letter. Page change: the old cards fade
 * out, the new ones rise in one after another and the blue page marker slides to the new number.
 * Hover: the card lifts, the photo zooms and the title turns blue.
 */
const posts = (await getPosts()).slice(0, press.perPage * press.maxPages);
const pages = Array.from({ length: Math.ceil(posts.length / press.perPage) }, (_, p) => posts.slice(p * press.perPage, (p + 1) * press.perPage));
const initials = (name: string) =>
  name
    .replace(/^(Dr|Mr|Mrs|Ms)\.?\s+/i, "")
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

{
  posts.length > 0 && (
    <section class="bg-surface pt-16 pb-20 sm:pt-24 lg:pt-[120px] lg:pb-[140px]" aria-labelledby="press-title" data-press>
      <Container>
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <Eyebrow {...press.eyebrow} />
            <SplitText as="h2" id="press-title" mode="chars" text={press.title} class="mt-4 text-h1 leading-[1.3] font-medium tracking-[-0.0375em] text-ink-2" />
          </div>
          <Button href={press.viewAll.href} variant="outline" size="xl" class="border-black/16 bg-transparent text-ink">
            {press.viewAll.label}
          </Button>
        </div>

        <div class="mt-10 lg:mt-12">
          {pages.map((page, p) => (
            <ul class="press-page grid gap-12 md:grid-cols-3 md:gap-8" data-page={p} hidden={p > 0}>
              {page.map((post) => (
                <li class="press-card group relative flex flex-col">
                  <div class="overflow-hidden rounded-lg">
                    <Image
                      src={post.data.image}
                      alt={post.data.imageAlt}
                      widths={[400, 600, 800]}
                      sizes="(min-width: 1440px) 395px, (min-width: 768px) 30vw, 100vw"
                      class="press-img aspect-[395/270] w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <p class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-[18px] text-muted">
                    {post.data.author.avatar ? (
                      <Image src={post.data.author.avatar} alt="" width={48} height={48} class="size-6 rounded-full object-cover" />
                    ) : (
                      <span class="flex size-6 items-center justify-center rounded-full bg-[#c8defb] text-[10px] font-medium text-ink-2" aria-hidden="true">
                        {initials(post.data.author.name)}
                      </span>
                    )}
                    <span class="font-medium text-ink">{post.data.author.name}</span>
                    <span class="flex gap-2 whitespace-nowrap">
                      <span aria-hidden="true">·</span>
                      <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                    </span>
                    <span class="flex gap-2 whitespace-nowrap">
                      <span aria-hidden="true">·</span>
                      <span>{post.data.readingTime}</span>
                    </span>
                  </p>
                  <SplitText
                    as="h3"
                    mode="chars"
                    text={post.data.title}
                    class="press-title mt-4 text-[22px] leading-[1.22] font-medium tracking-[-0.015em] text-ink-2 transition-colors duration-300 sm:text-2xl"
                  />
                  <p class="mt-[7px] max-w-[360px] text-base leading-[26px] text-[#4c565f]">{post.data.excerpt}</p>
                  <a href={`/blog/${post.id}`} class="absolute inset-0 rounded-lg outline-offset-4 focus-visible:outline-2 focus-visible:outline-brand" aria-label={post.data.title} />
                </li>
              ))}
            </ul>
          ))}
        </div>

        {pages.length > 1 && (
          <nav class="relative mt-12 flex gap-2" aria-label={press.labels.pagination} hidden data-pager>
            <span class="pager-dot absolute top-0 left-0 size-10 rounded-full bg-brand-bright" aria-hidden="true" />
            {pages.map((_, p) => (
              <button
                type="button"
                class="pager-btn relative flex size-10 items-center justify-center rounded-full border border-ink-2/12 text-[15px] font-medium text-ink-2 transition-colors duration-300 hover:bg-canvas-2 aria-[current=true]:border-transparent aria-[current=true]:text-white aria-[current=true]:hover:bg-transparent"
                aria-label={`${press.labels.page} ${p + 1}`}
                aria-current={p === 0 ? "true" : undefined}
                data-goto={p}
              >
                {p + 1}
              </button>
            ))}
          </nav>
        )}
      </Container>
    </section>
  )
}

<style>
  .press-card {
    transition: translate 0.5s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  .press-img {
    transition: scale 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pager-dot {
    transition: translate 0.55s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .press-card:hover {
      translate: 0 -4px;
    }
    .press-card:hover .press-img {
      scale: 1.04;
    }
  }
  @media (hover: hover) {
    .press-card:hover .press-title {
      color: var(--color-brand);
    }
  }
  .press-card:focus-within .press-title {
    color: var(--color-brand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .press-page[data-enter] > li {
      animation: press-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--n) * 0.08s);
    }
    .press-page[data-leave] {
      opacity: 0;
      translate: 0 -8px;
      transition:
        opacity 0.2s ease,
        translate 0.2s ease;
    }
  }
  @keyframes press-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  document.querySelectorAll<HTMLElement>("[data-press]").forEach((root) => {
    const pager = root.querySelector<HTMLElement>("[data-pager]");
    if (!pager) return;
    pager.hidden = false;
    const pages = [...root.querySelectorAll<HTMLElement>("[data-page]")];
    const buttons = [...pager.querySelectorAll<HTMLButtonElement>("[data-goto]")];
    const dot = pager.querySelector<HTMLElement>(".pager-dot");
    pages.forEach((page) => [...page.children].forEach((li, n) => (li as HTMLElement).style.setProperty("--n", String(n))));
    let current = 0;
    let busy = 0;
    const moveDot = (p: number) => {
      const b = buttons[p];
      if (dot && b) dot.style.translate = `${b.offsetLeft}px 0`;
    };
    moveDot(0);

    const show = (target: number) => {
      pages.forEach((page, i) => {
        page.hidden = i !== target;
        page.removeAttribute("data-leave");
        page.removeAttribute("data-enter");
      });
      const page = pages[target];
      // Restart the letter pop of the titles on the new page.
      page.querySelectorAll<HTMLElement>("[data-about-split]").forEach((el) => el.removeAttribute("data-in"));
      void page.offsetWidth;
      page.setAttribute("data-enter", "");
      page.querySelectorAll<HTMLElement>("[data-about-split]").forEach((el) => el.setAttribute("data-in", ""));
    };

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const target = Number(button.dataset.goto);
        if (target === current) return;
        buttons.forEach((b, i) => (i === target ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current")));
        moveDot(target);
        window.clearTimeout(busy);
        if (reduceMotion()) {
          pages.forEach((page, i) => (page.hidden = i !== target));
        } else {
          pages[current].setAttribute("data-leave", "");
          busy = window.setTimeout(() => show(target), 200);
        }
        current = target;
      }),
    );
  });
</script>
