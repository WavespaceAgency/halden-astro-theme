---
/**
 * Framer-style text effect, split at build time (no layout shift):
 *   mode="chars"  each letter pops in (scale 0.1 → 1 on Framer's spring, 0.8s, 0.03s apart, 0.15s delay) – headings
 *   mode="words"  each word un-blurs and fades in (0.7s, 0.025s apart, 0.3s delay) – paragraphs
 * Timings and spring curves are the ones the Framer site runs (read from its WAAPI animations).
 * trigger="load" starts on page load, "view" when the element scrolls into view.
 * Screen readers get the plain text; the animated copy is aria-hidden.
 * Without JavaScript or with "reduce motion" the text is simply shown.
 */
import type { HTMLTag } from "astro/types";

export interface SplitPart {
  text: string;
  class?: string;
  /** Start this part on a new line (desktop: always; set `breakClass` to control when). */
  break?: boolean;
}

interface Props {
  as?: HTMLTag;
  /** Plain text, or parts with their own classes (two-tone headings). */
  text: string | SplitPart[];
  mode?: "chars" | "words";
  trigger?: "load" | "view";
  /** Start delay in seconds. */
  delay?: number;
  /** Seconds between letters / words. */
  stagger?: number;
  /** Classes for the <br> before a part with `break` (e.g. "hidden sm:block"). */
  breakClass?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = "p",
  text,
  mode = "words",
  trigger = "view",
  delay,
  stagger,
  breakClass,
  class: className,
  ...attrs
} = Astro.props;

const d = delay ?? (mode === "chars" ? 0.15 : 0.3);
const st = stagger ?? (mode === "chars" ? 0.03 : 0.025);
const parts: SplitPart[] = typeof text === "string" ? [{ text }] : text;
const plain = parts.map((p) => p.text).join(" ").replace(/\s+/g, " ").trim();

let index = 0;
const rendered = parts.map((part) => ({
  ...part,
  words: part.text
    .trim()
    .split(/\s+/)
    .map((word) => ({
      word,
      chars: mode === "chars" ? [...word].map((ch) => ({ ch, i: index++ })) : [],
      i: mode === "words" ? index++ : 0,
    })),
}));
---

<Tag class={className} data-about-split={mode} data-trigger={trigger} style={`--d:${d}s;--s:${st}s`} {...attrs}>
  <span class="sr-only">{plain}</span>
  <span aria-hidden="true">
    {
      rendered.map((part, p) => (
        <Fragment>
          {part.break ? <br class={breakClass} /> : p > 0 ? " " : null}
          <span class={part.class}>
            {part.words.map((w, wi) => (
              <Fragment>
                {wi > 0 && " "}
                {mode === "chars" ? (
                  <span class="ab-word">
                    {w.chars.map((c) => (
                      <span class="ab-c" style={`--i:${c.i}`}>
                        {c.ch}
                      </span>
                    ))}
                  </span>
                ) : (
                  <span class="ab-w" style={`--i:${w.i}`}>
                    {w.word}
                  </span>
                )}
              </Fragment>
            ))}
          </span>
        </Fragment>
      ))
    }
  </span>
</Tag>

<style is:global>
  .ab-word,
  .ab-c,
  .ab-w {
    display: inline-block;
  }
  .ab-word {
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    html.js [data-about-split] .ab-c {
      opacity: 0.001;
      transform: scale(0.1);
    }
    html.js [data-about-split] .ab-w {
      opacity: 0.001;
      filter: blur(8px);
    }
    html.js [data-about-split][data-in] .ab-c {
      animation: ab-pop 0.8s both;
      animation-delay: calc(var(--d) + var(--i) * var(--s));
      /* Fallback, then Framer's spring (peaks at 1.09, settles at 1). */
      animation-timing-function: cubic-bezier(0.34, 1.45, 0.64, 1);
      animation-timing-function: linear(0, 0.074 3.8%, 0.244 7.6%, 0.45 11.4%, 0.649 15.2%, 0.818 19%, 0.944 22.8%, 1.028 26.6%, 1.075 30.4%, 1.094 34.2%, 1.092 38%, 1.078 41.8%, 1.06 45.6%, 1.04 49.4%, 1.023 53.2%, 1.009 57%, 1 60.8%, 0.994 64.6%, 0.992 68.4%, 0.991 72.2%, 0.992 75.9%, 0.994 79.7%, 0.996 83.5%, 0.997 87.3%, 0.999 91.1%, 1 94.9%, 1);
    }
    html.js [data-about-split][data-in] .ab-w {
      animation: ab-blur 0.7s both;
      animation-delay: calc(var(--d) + var(--i) * var(--s));
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      animation-timing-function: linear(0, 0.058 4.3%, 0.186 8.7%, 0.338 13%, 0.487 17.4%, 0.619 21.7%, 0.728 26.1%, 0.814 30.4%, 0.878 34.8%, 0.925 39.1%, 0.957 43.5%, 0.979 47.8%, 0.992 52.2%, 1 56.5%, 1.004 60.9%, 1.006 65.2%, 1.006 69.6%, 1.006 73.9%, 1.005 78.3%, 1.004 82.6%, 1.003 87%, 1.002 91.3%, 1);
    }
  }
  @keyframes ab-pop {
    from {
      opacity: 0.001;
      transform: scale(0.1);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes ab-blur {
    from {
      opacity: 0.001;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: none;
    }
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>("[data-about-split]:not([data-in])");
  const io =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              (e.target as HTMLElement).setAttribute("data-in", "");
              io?.unobserve(e.target);
            }
          },
          { rootMargin: "0px", threshold: 0 },
        )
      : null;
  els.forEach((el) => {
    if (el.dataset.trigger === "load" || !io) el.setAttribute("data-in", "");
    else io.observe(el);
  });
</script>
