---
import { markPaths } from "./mock";

interface Props {
  class?: string;
  /** Stroke width on the 24px grid. */
  stroke?: number;
}
/** Halden "H" mark used inside the mockup tiles (no dot). Uses currentColor. */
const { class: className = "size-6", stroke = 1.48 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path d={markPaths.circle} stroke="currentColor" stroke-width={stroke}></path>
  <path d={markPaths.h} stroke="currentColor" stroke-width={stroke} stroke-linecap="round"></path>
</svg>
