---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { howItWorks } from "@/config/pages/platform";
import JobAnswer from "./JobAnswer.astro";
import JobFollowUp from "./JobFollowUp.astro";
import JobSchedule from "./JobSchedule.astro";
import JobVerify from "./JobVerify.astro";

/**
 * "How it works": four jobs with a product mockup each (Figma 1440×1128, Framer "HowItWorks").
 * With JavaScript the job row sticks while you scroll through 1500px and the active job cross-fades
 * at +40px, +540px and +1040px of the track – the same thresholds as the Framer site, on every width.
 * Desktop (1024px+) shows tabs with a sliding indicator; phones/tablets pin the whole job card (mockup,
 * title, text) at 72px like Framer mobile. Without JS, or when the card is taller than the screen
 * (e.g. landscape phones), the four jobs are stacked.
 * Mockups are drawn on an 828×520 canvas and scaled down to fit narrower columns.
 */
const h = howItWorks;
const arts = [JobAnswer, JobSchedule, JobVerify, JobFollowUp];
const washes = [
  "-left-[200px] -top-[200px] h-[420px] w-[520px] bg-[rgb(156_225_222/0.95)]",
  "-left-[220px] top-[220px] h-[560px] w-[560px] bg-[rgb(123_175_249/0.95)]",
  "left-[250px] top-[420px] h-[300px] w-[520px] bg-[rgb(127_211_203/0.9)]",
  "left-[528px] -top-[80px] h-[520px] w-[560px] bg-[rgb(224_238_160/0.95)]",
  "left-[180px] top-[80px] h-[320px] w-[460px] bg-[rgb(255_255_255/0.7)]",
];
---

<section id={h.id} class="hiw bg-canvas" data-hiw>
  <div class="mx-auto max-w-[1360px] px-4 pt-20 pb-20 sm:px-6 lg:px-10 lg:pt-32 lg:pb-32">
    <div data-fx-auto>
      <SectionHeading
        {...h.heading}
        align="center"
        class="[&>p:first-child]:!mb-[19px]"
        descriptionClass="!mt-[19px] max-w-[620px] !text-muted"
      />
    </div>

    <div class="hiw-track mt-12 lg:mt-8" data-hiw-track>
      <div class="hiw-sticky">
        <div role="tablist" aria-label={h.tabsLabel} aria-orientation="vertical" class="hiw-tabs relative hidden flex-col gap-1" data-hiw-tabs>
          <span class="hiw-ind" aria-hidden="true" data-hiw-ind></span>
          {
            h.jobs.map((job, i) => (
              <button
                type="button"
                role="tab"
                id={`hiw-tab-${job.id}`}
                aria-controls={`hiw-job-${job.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="flex min-h-11 items-center gap-4 border-l-2 border-line pl-[18px] text-left text-[13px] leading-4 font-medium tracking-[0.02em] text-body uppercase transition-colors duration-300 hover:text-ink focus-visible:text-ink aria-selected:text-ink"
              >
                <span>{job.number}</span>
                <span>{job.label}</span>
              </button>
            ))
          }
        </div>

        <div class="hiw-shared-bg hidden" aria-hidden="true">
          <div class="hiw-scale">
            <div class="hiw-canvas">
              <div class="absolute inset-0 overflow-hidden rounded-card bg-[#ecf7f1]">
                {washes.map((w) => <span class:list={["absolute rounded-full blur-[90px]", w]} />)}
              </div>
            </div>
          </div>
        </div>

        <div class="hiw-jobs">
          {
            h.jobs.map((job, i) => {
              const Art = arts[i];
              return (
                <article id={`hiw-job-${job.id}`} class:list={["hiw-job", i === 0 && "is-active"]} data-tab={`hiw-tab-${job.id}`} data-hiw-job>
                  <div class="hiw-art">
                    <div class="hiw-scale">
                      <div class="hiw-canvas">
                        <div class="hiw-own-bg absolute inset-0 overflow-hidden rounded-card bg-[#ecf7f1]" aria-hidden="true">
                          {washes.map((w) => (
                            <span class:list={["absolute rounded-full blur-[90px]", w]} />
                          ))}
                        </div>
                        <div class="absolute top-10 right-10 left-10 flex items-center justify-between" aria-hidden="true">
                          <span class="flex items-center gap-3 text-sm leading-[17px] font-medium tracking-[0.02em] text-ink uppercase">
                            <span class="h-4 w-0.5 bg-ink" />
                            {job.number} {job.label}
                          </span>
                          <span class="flex h-7 items-center gap-2 rounded-full bg-canvas px-3 text-[13px] leading-4 text-ink">
                            <span class="hiw-dot size-1.5 rounded-full bg-[#6bb1ff]" />
                            {h.status}
                          </span>
                        </div>
                        <div class="hiw-stage absolute inset-0">
                          <Art />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="hiw-detail">
                    <h3 class="text-h3 font-medium text-ink" data-fx="chars" data-fx-manual>
                      {job.title}
                    </h3>
                    <p class="mt-2 text-lead text-muted" data-fx="words" data-fx-manual style="--fx-d: 0.25s">
                      {job.description}
                    </p>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
      <div class="hiw-spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  /* ---------- Mockup canvas (828×520) scaled to the column width (--s set by the script) */
  .hiw-scale {
    position: relative;
    width: 100%;
    aspect-ratio: 828 / 520;
    overflow: hidden; /* without JS the canvas stays 828px wide – never let it widen the page */
    border-radius: var(--radius-card);
  }
  .hiw-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 828px;
    height: 520px;
    transform: scale(var(--s, 1));
    transform-origin: 0 0;
  }

  /* ---------- Stacked layout (phones, tablets, no JS) */
  .hiw-jobs {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .hiw-detail {
    margin-top: 1.75rem;
    max-width: 36rem;
  }

  /* ---------- Pinned layout (JS adds .is-pinned): the job card sticks while the 1500px spacer scrolls by */
  .hiw {
    /* Framer's 650ms spring (opacity) for the job cross-fade */
    --hiw-ease: linear(0 0%, 0.012 1.5625%, 0.0428 3.125%, 0.0863 4.6875%, 0.1377 6.25%, 0.1937 7.8125%, 0.2515 9.375%, 0.3094 10.9375%, 0.3661 12.5%, 0.4205 14.0625%, 0.4721 15.625%, 0.5206 17.1875%, 0.5658 18.75%, 0.6077 20.3125%, 0.6462 21.875%, 0.6814 23.4375%, 0.7136 25%, 0.7428 26.5625%, 0.7694 28.125%, 0.7934 29.6875%, 0.815 31.25%, 0.8346 32.8125%, 0.8521 34.375%, 0.8679 35.9375%, 0.8821 37.5%, 0.8948 39.0625%, 0.9062 40.625%, 0.9163 42.1875%, 0.9254 43.75%, 0.9336 45.3125%, 0.9408 46.875%, 0.9473 48.4375%, 0.9531 50%, 0.9582 51.5625%, 0.9628 53.125%, 0.9669 54.6875%, 0.9706 56.25%, 0.9738 57.8125%, 0.9767 59.375%, 0.9793 60.9375%, 0.9816 62.5%, 0.9836 64.0625%, 0.9854 65.625%, 0.987 67.1875%, 0.9885 68.75%, 0.9898 70.3125%, 0.9909 71.875%, 0.9919 73.4375%, 0.9928 75%, 0.9936 76.5625%, 0.9943 78.125%, 0.9949 79.6875%, 0.9955 81.25%, 0.996 82.8125%, 0.9964 84.375%, 0.9968 85.9375%, 0.9972 87.5%, 0.9975 89.0625%, 0.9978 90.625%, 0.998 92.1875%, 0.9982 93.75%, 1 95.3125%, 1 96.875%, 1 98.4375%, 1 100%);
  }
  .hiw-spacer {
    display: none;
  }
  .is-pinned .hiw-spacer {
    display: block;
    height: 1500px;
  }
  .is-pinned .hiw-sticky {
    position: sticky;
    top: 72px;
  }
  .is-pinned .hiw-jobs {
    display: grid;
  }
  .is-pinned .hiw-job {
    grid-area: 1 / 1;
    transition: visibility 0s linear 0.65s;
  }
  .is-pinned .hiw-job:not(.is-active) {
    visibility: hidden;
  }
  .is-pinned .hiw-job.is-active {
    visibility: visible;
    transition-delay: 0s;
  }
  .is-pinned .hiw-detail {
    transition: opacity 0.2s ease;
  }
  .is-pinned .hiw-job:not(.is-active) .hiw-detail {
    opacity: 0;
  }
  .is-pinned .hiw-art {
    transition: opacity 0.65s var(--hiw-ease);
  }
  .is-pinned .hiw-job:not(.is-active) .hiw-art {
    opacity: 0;
  }

  /* Sliding indicator of the active tab (position set by the script) */
  .hiw-ind {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: var(--ind-h, 44px);
    background: var(--color-ink);
    transform: translateY(var(--ind-y, 0));
    transition:
      transform 0.55s cubic-bezier(0.34, 1.3, 0.64, 1),
      height 0.55s cubic-bezier(0.34, 1.3, 0.64, 1);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .is-pinned .hiw-sticky {
      top: 40px;
      height: 600px;
      padding-top: 80px;
      display: grid;
      grid-template-columns: minmax(0, 404fr) minmax(0, 828fr);
      column-gap: 48px;
    }
    .is-pinned .hiw-tabs {
      display: flex;
      grid-area: 1 / 1;
      align-self: start;
      z-index: 1;
    }
    .is-pinned .hiw-shared-bg {
      display: block;
      grid-area: 1 / 2;
    }
    .is-pinned .hiw-jobs {
      grid-area: 1 / 1 / 2 / 3;
      grid-template-columns: subgrid;
    }
    .is-pinned .hiw-job {
      grid-area: 1 / 1 / 2 / 3;
      display: grid;
      grid-template-columns: subgrid;
    }
    .is-pinned .hiw-art {
      grid-area: 1 / 2;
      transition: none;
    }
    .is-pinned .hiw-job:not(.is-active) .hiw-art {
      opacity: 1;
    }
    .is-pinned .hiw-detail {
      grid-area: 1 / 1;
      margin-top: 228px;
      max-width: 360px;
    }
    .is-pinned .hiw-own-bg {
      display: none;
    }
    /* Desktop: the shared wash stays, only the mockup content cross-fades */
    .is-pinned .hiw-job .hiw-canvas > :not(.hiw-own-bg) {
      transition:
        opacity 0.65s var(--hiw-ease),
        transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .is-pinned .hiw-job:not(.is-active) .hiw-canvas > :not(.hiw-own-bg) {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw :is(.hiw-art, .hiw-detail, .hiw-canvas > *, .hiw-ind) {
      transition: none !important;
    }
  }

  /* ---------- Hover: mockup cards and nodes lift, calendar slots light up (hover devices only) */
  @media (hover: hover) {
    .hiw-stage :global([data-a="s"]:hover) {
      translate: 0 -3px;
      filter: drop-shadow(0 10px 14px rgb(12 26 47 / 0.1));
    }
    .hiw-stage :global(.hiw-slot) {
      transition:
        background-color 0.2s ease,
        color 0.2s ease,
        scale 0.2s ease;
    }
    .hiw-stage :global(.hiw-slot:not(.bg-brand):hover) {
      scale: 1.06;
      background-color: #dfebfd;
      color: #2457d6;
    }
  }

  /* ---------- Mockup entrance (children with data-a, staggered by --i) */
  @media (prefers-reduced-motion: no-preference) {
    .hiw-stage :global([data-a]) {
      --d: calc(0.12s + var(--i, 0) * 0.08s);
      transition:
        opacity 0.5s ease var(--d),
        transform 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) var(--d),
        translate 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        filter 0.35s ease;
    }
    :global(html.js) .hiw-job:not(.is-on) .hiw-stage :global([data-a="s"]) {
      transform: scale(0.9);
    }
    :global(html.js) .hiw-job:not(.is-on) .hiw-stage :global([data-a="x"]) {
      opacity: 0;
      transform: translateX(-10px);
    }
    :global(html.js) .hiw-job:not(.is-on) .hiw-stage :global([data-a="p"]) {
      opacity: 0;
      transform: scale(0.6);
    }

    /* Small loops while a job is on screen */
    .hiw-job.is-on :global(.hiw-bar) {
      animation: hiw-wave 1.2s ease-in-out infinite;
      animation-delay: calc(var(--b) * -0.17s);
    }
    .hiw-job.is-on :global(.hiw-dot) {
      animation: var(--animate-pulse-soft);
    }
    .hiw-job.is-on :global(.hiw-flow) {
      animation: hiw-flow 1s linear infinite;
    }
    .hiw-job.is-on :global(.hiw-status) {
      animation: hiw-status 4.5s ease-in-out infinite;
      animation-delay: calc(var(--b) * 1.5s);
    }
  }
  @keyframes hiw-wave {
    0%,
    100% {
      transform: scaleY(0.45);
    }
    50% {
      transform: scaleY(1);
    }
  }
  @keyframes hiw-flow {
    to {
      stroke-dashoffset: -14;
    }
  }
  @keyframes hiw-status {
    0%,
    20%,
    100% {
      transform: none;
    }
    8% {
      transform: scale(1.08);
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";
  import { scrollToY } from "@/scripts/smooth-scroll";

  const section = document.querySelector<HTMLElement>("[data-hiw]");
  if (section) {
    const track = section.querySelector<HTMLElement>("[data-hiw-track]")!;
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const jobs = Array.from(section.querySelectorAll<HTMLElement>("[data-hiw-job]"));
    const ind = section.querySelector<HTMLElement>("[data-hiw-ind]");
    const desktop = window.matchMedia("(min-width: 1024px)");
    // Framer: the next job fades in at +40px, +540px and +1040px of the track (1500px of scroll space).
    const FIRST = 40;
    const STEP = 500;
    let active = -1;
    let pinned = false;

    // Scale the 828×520 mockups to their column.
    const ro = new ResizeObserver((entries) => {
      for (const e of entries) (e.target as HTMLElement).style.setProperty("--s", String(e.contentRect.width / 828));
    });
    section.querySelectorAll<HTMLElement>(".hiw-scale").forEach((el) => ro.observe(el));

    const playText = (job: HTMLElement) => {
      job.querySelectorAll<HTMLElement>("[data-fx]").forEach((el) => {
        el.removeAttribute("data-fx-play");
        void el.offsetWidth; // restart the CSS animation
        el.setAttribute("data-fx-play", "");
      });
    };

    const moveIndicator = (index: number) => {
      const tab = tabs[index];
      if (!ind || !tab || !tab.offsetHeight) return;
      ind.style.setProperty("--ind-y", `${tab.offsetTop}px`);
      ind.style.setProperty("--ind-h", `${tab.offsetHeight}px`);
    };

    const setActive = (index: number) => {
      if (index === active) return;
      active = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      moveIndicator(index);
      jobs.forEach((job, i) => {
        const on = i === index;
        job.classList.toggle("is-active", on);
        job.classList.toggle("is-on", on);
        job.toggleAttribute("inert", !on);
        if (on) playText(job);
      });
    };

    const indexFromScroll = () => {
      const offset = -track.getBoundingClientRect().top;
      if (offset < FIRST) return 0;
      return Math.min(jobs.length - 1, Math.floor((offset - FIRST) / STEP) + 1);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        if (pinned) setActive(indexFromScroll());
      });
    };

    // Stacked mode: every job is shown; play its mockup + text when it scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (pinned) return;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const job = e.target as HTMLElement;
          if (job.classList.contains("is-on")) continue;
          job.classList.add("is-on");
          playText(job);
        }
      },
      { threshold: 0.35 },
    );

    /** Pin on desktop, and on smaller screens when the tallest job card fits under the 72px sticky top. */
    const shouldPin = () => {
      if (desktop.matches) return true;
      const tallest = Math.max(...jobs.map((job) => job.offsetHeight));
      return tallest + 72 + 24 <= window.innerHeight;
    };

    const setMode = () => {
      const next = shouldPin();
      const tabsShown = next && desktop.matches;
      jobs.forEach((job) => {
        // Tab semantics only exist while the tabs are shown (desktop).
        if (tabsShown) {
          job.setAttribute("role", "tabpanel");
          job.setAttribute("aria-labelledby", job.dataset.tab ?? "");
        } else {
          job.removeAttribute("role");
          job.removeAttribute("aria-labelledby");
        }
      });
      if (next === pinned && next) {
        moveIndicator(active);
        return;
      }
      pinned = next;
      section.classList.toggle("is-pinned", pinned);
      active = -1;
      if (pinned) setActive(indexFromScroll());
      else
        jobs.forEach((job) => {
          job.classList.remove("is-active");
          job.removeAttribute("inert");
        });
    };

    if (reduceMotion()) jobs.forEach((job) => job.classList.add("is-on"));
    jobs.forEach((job) => io.observe(job));
    setMode();
    desktop.addEventListener("change", setMode);
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setMode, 150);
    });
    window.addEventListener("scroll", onScroll, { passive: true });

    // Tabs: click / arrow keys scroll to the middle of that job's scroll range.
    const goTo = (i: number) => {
      const trackTop = track.getBoundingClientRect().top + window.scrollY;
      const y = i === 0 ? trackTop - 60 : trackTop + FIRST + (i - 1) * STEP + STEP / 2;
      scrollToY(y);
      setActive(i);
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => goTo(i));
      tab.addEventListener("keydown", (e) => {
        const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
        let next = -1;
        if (e.key in keys) next = (i + keys[e.key] + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        tabs[next].focus();
        goTo(next);
      });
    });
  }
</script>
