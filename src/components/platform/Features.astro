---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { features } from "@/config/pages/platform";
import FeatureArt from "./FeatureArt.astro";

/**
 * "Built for how clinics work": six coloured cards with small product illustrations
 * (Figma 1440×1505, 3 × 2 grid of 467×496 cards, 8px from the page edge).
 * Motion (from Framer): parts rise / pop in once, then a 5.4s story loops in each card – dashed connectors
 * light up one after another, badges and status pills pop back in, skeleton lines redraw.
 * Hover: the card lifts 4px (as Framer) with a soft shadow and the illustration zooms slightly.
 */
---

<section class="bg-surface px-2 pt-20 pb-20 lg:pt-[120px] lg:pb-[130px]">
  <div class="mx-auto max-w-[1424px]">
    <div data-fx-auto class="px-2">
      <SectionHeading
        {...features.heading}
        align="center"
        class="[&>p:first-child]:!mb-2.5"
        descriptionClass="!mt-2.5 max-w-[504px] !text-muted"
      />
    </div>
    <ul class="mt-12 grid gap-3 md:grid-cols-2 lg:mt-[88px] lg:grid-cols-3">
      {
        features.items.map((item) => (
          <li class="feature-card flex flex-col overflow-hidden rounded-card" style={`background:${item.background}`} data-feature>
            <div class="flex h-[290px] items-center justify-center p-6 sm:h-[340px]">
              <div class="origin-center max-[419px]:scale-[0.8] sm:max-lg:scale-[0.85] lg:max-xl:scale-[0.8]">
                <FeatureArt art={item.art} />
              </div>
            </div>
            <div class="px-6 pt-[22px] pb-8 sm:px-10 sm:pb-10">
              <h3 class="text-h3 font-medium text-ink" data-fx="chars">
                {item.title}
              </h3>
              <p class="mt-1 max-w-[387px] text-lead text-body" data-fx="words">
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .feature-card :global([data-b]) {
      transition:
        opacity 0.5s ease,
        transform 0.6s cubic-bezier(0.34, 1.3, 0.64, 1);
      transition-delay: calc(0.1s + var(--i, 0) * 0.1s);
    }
    :global(html.js) .feature-card:not(.is-on) :global([data-b="up"]) {
      opacity: 0;
      transform: translateY(12px);
    }
    :global(html.js) .feature-card:not(.is-on) :global([data-b="pop"]) {
      opacity: 0;
      transform: scale(0.6);
    }
    :global(html.js) .feature-card:not(.is-on) :global([data-b="line"]) {
      transform: scaleX(0);
    }
    .feature-card :global([data-b="line"]) {
      transform-origin: 0 50%;
    }
    .feature-card.is-on :global(.feature-bar) {
      animation: feature-wave 1.1s ease-in-out infinite;
      animation-delay: calc(var(--b) * -0.13s);
    }
    .feature-card.is-on :global(.feature-dot) {
      animation: var(--animate-pulse-soft);
    }
  }
  /* 5.4s story loop (Framer "Connector" / "Badge" / "Status" / "Divider"); starts after the entrance */
  @media (prefers-reduced-motion: no-preference) {
    .feature-card.is-on :global(.fa-conn) {
      animation: fa-conn 5.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
      animation-delay: calc(1.6s + var(--c, 0) * 0.8s);
    }
    .feature-card.is-on :global(.fa-badge) {
      animation: fa-badge 5.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
      animation-delay: calc(1.6s + var(--k, 0) * 0.8s);
    }
    .feature-card.is-on :global([data-b="line"]) {
      animation: fa-line 5.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
      animation-delay: calc(2s + var(--i, 0) * 0.06s);
    }
    .feature-card.is-on :global(.fa-ring) {
      animation: fa-ring 1.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
  }
  @keyframes fa-conn {
    0%,
    14%,
    30%,
    100% {
      opacity: 0.3;
    }
    16%,
    22% {
      opacity: 1;
    }
  }
  @keyframes fa-badge {
    0%,
    22%,
    100% {
      opacity: 1;
      transform: none;
    }
    6%,
    14% {
      opacity: 0;
      transform: scale(0.6);
    }
    19% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @keyframes fa-line {
    0%,
    26%,
    100% {
      transform: none;
    }
    6%,
    12% {
      transform: scaleX(0);
    }
  }
  @keyframes fa-ring {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  /* Hover (pointer devices): lift + soft shadow, illustration zooms a little */
  @media (hover: hover) {
    .feature-card {
      transition:
        translate 0.45s cubic-bezier(0.34, 1.3, 0.64, 1),
        box-shadow 0.45s ease;
    }
    .feature-card :global(.feature-art) {
      transition: scale 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .feature-card:hover {
      translate: 0 -4px;
      box-shadow: 0 24px 48px -24px rgb(12 26 47 / 0.22);
    }
    .feature-card:hover :global(.feature-art) {
      scale: 1.03;
    }
  }

  @keyframes feature-wave {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>("[data-feature]");
  // Connectors light up in DOM order inside each card.
  cards.forEach((card) => card.querySelectorAll<HTMLElement>(".fa-conn").forEach((el, i) => el.style.setProperty("--c", String(i))));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-on");
          io.unobserve(e.target);
        }
      },
      { threshold: 0.35 },
    );
    cards.forEach((card) => io.observe(card));
  } else cards.forEach((card) => card.classList.add("is-on"));
</script>
