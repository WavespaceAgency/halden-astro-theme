---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { setup } from "@/config/pages/platform";

/** Setup: "Live in about two weeks" – three numbered step cards (Figma 1440×691). */
---

<section class="bg-canvas-2 py-20 lg:py-[120px]">
  <Container>
    <div data-fx-auto>
      <SectionHeading {...setup.heading} class="[&>p:first-child]:!mb-4" />
    </div>
    <ol class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-3">
      {
        setup.steps.map((step) => (
          <li class="group flex flex-col gap-10 rounded-card bg-surface p-7 transition-[translate,box-shadow,background-color] duration-[450ms] ease-[cubic-bezier(0.34,1.3,0.64,1)] hover:-translate-y-1 motion-reduce:transition-none hover:shadow-[0_24px_48px_-24px_rgb(12_26_47/0.18)] lg:min-h-[284px] lg:p-9">
            <p class="flex items-center gap-3">
              <span class="flex size-11 items-center justify-center rounded-full bg-brand transition-transform duration-500 ease-[cubic-bezier(0.34,1.45,0.64,1)] group-hover:scale-110 motion-reduce:transition-none font-mono text-sm leading-[18px] font-medium text-white">
                {step.number}
              </span>
              <span class="font-mono text-sm leading-[18px] font-semibold tracking-[0.06em] text-body uppercase">{step.when}</span>
            </p>
            <div class="flex flex-col gap-2">
              <h3 class="text-h3 font-medium text-ink" data-fx="chars">
                {step.title}
              </h3>
              <p class="text-lead text-body" data-fx="words">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
