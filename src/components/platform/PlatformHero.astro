---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import { hero } from "@/config/pages/platform";
import { getImage } from "@/lib/images";

/**
 * Platform hero: rounded photo card (Figma 1376×600) with a centred heading and one button.
 * Like Framer, the card spans the viewport with 32px side margins (1376 at 1440, 1856 at 1920).
 * On hover devices the photo drifts gently with the pointer (off with "reduce motion").
 */
---

<section class="pt-3 pb-[18px] sm:pb-6 lg:pt-0 lg:pb-8">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="hero-card relative isolate flex min-h-[410px] items-center justify-center overflow-hidden rounded-card px-5 py-10 sm:min-h-[480px] lg:h-[600px] lg:py-0" data-hero-card>
      <Image
        src={getImage(hero.image)}
        alt=""
        widths={[640, 1024, 1376, 1856, 2400]}
        sizes="(min-width: 1024px) calc(100vw - 64px), calc(100vw - 32px)"
        class="hero-photo absolute inset-0 -z-20 size-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Figma overlay is 962px tall on a 600px card, so only its top 62% shows -->
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(9_20_20/0.62)_0%,rgb(19_44_52/0.35)_88%,rgb(21_49_56/0.355)_100%)]"
        aria-hidden="true"
      >
      </div>

      <div class="flex max-w-[760px] flex-col items-center gap-8 text-center">
        <div class="flex flex-col items-center gap-3">
          <h1 class="text-display font-medium whitespace-pre-line text-balance text-white" data-fx="chars" data-fx-load style="--fx-d: 0.2s; --fx-step: 0.046s">
            {hero.title}
          </h1>
          <p class="max-w-[574px] text-lead text-white/85" data-fx="words" data-fx-load style="--fx-d: 0.45s">{hero.description}</p>
        </div>
        <Button
          href={hero.cta.href}
          size="lg"
          class="rounded-[22px] text-base shadow-[0_0_24px_0_rgb(44_103_246/0.45)]"
        >
          {hero.cta.label}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-photo {
      transform: translate3d(calc(var(--px, 0) * -14px), calc(var(--py, 0) * -10px), 0) scale(var(--pz, 1));
      transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  // Gentle pointer parallax on the hero photo (hover devices only).
  const card = document.querySelector<HTMLElement>("[data-hero-card]");
  if (card && !reduceMotion() && window.matchMedia("(hover: hover)").matches) {
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty("--px", (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
      card.style.setProperty("--py", (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
      card.style.setProperty("--pz", "1.04");
    });
    card.addEventListener("pointerleave", () => {
      card.style.setProperty("--px", "0");
      card.style.setProperty("--py", "0");
      card.style.setProperty("--pz", "1");
    });
  }
</script>
