---
/**
 * Row of result numbers in blog posts (count up when scrolled into view):
 *   <Stats items={[{ value: "94%", label: "calls handled end to end" }]} />
 * Cards cycle through the sky, violet and mint tints.
 */
import { cn } from "@/lib/utils";

interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
const tints = ["bg-sky-soft", "bg-violet-tint", "bg-mint-tint"];
---

<dl class="grid gap-3 sm:grid-cols-3 sm:gap-4" data-stagger>
  {
    items.map((item, i) => (
      <div class={cn("flex flex-col-reverse gap-2 rounded-[20px] p-6", tints[i % tints.length])}>
        <dt class="text-[15px] leading-[22px] text-body">{item.label}</dt>
        <dd class="text-[40px] leading-[57px] font-medium tracking-[-0.03em] text-ink-2 sm:text-[44px]" data-count={item.value}>
          {item.value}
        </dd>
      </div>
    ))
  }
</dl>
