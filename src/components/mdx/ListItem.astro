---
/** One item of the blog check list: blue check circle + text. */
---

<li class="flex items-start gap-3 text-[17px] leading-[23px] text-body sm:text-lg">
  <svg class="mt-px size-[22px] shrink-0" viewBox="0 0 22 22" fill="none" aria-hidden="true">
    <rect width="22" height="22" rx="11" class="fill-brand"></rect>
    <path d="M6 11.5 9.5 15 16 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span><slot /></span>
</li>
