---
interface Props {
  class?: string;
}
/** Blue check circle (Figma "Check"). */
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 22 22" fill="none" aria-hidden="true">
  <rect width="22" height="22" rx="11" class="fill-brand"></rect>
  <path d="M6 11.5 9.5 15 16 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
