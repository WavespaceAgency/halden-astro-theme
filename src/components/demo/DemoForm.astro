---
import { bookDemo } from "@/config/pages/book-a-demo";
import { buttonClasses } from "@/lib/button";
import { cn } from "@/lib/utils";

/**
 * "Book your demo" form. Labels, browser-side validation with inline errors
 * and a success message. Nothing is sent yet – hook it up to your CRM or form
 * service in the script below (see TODO).
 */
const f = bookDemo.form;
const { name, email, clinic, phone, locations, message } = f.fields;

const input =
  "w-full rounded-[10px] border border-line bg-surface px-[18px] text-base leading-[26px] text-ink placeholder:text-muted transition-[border-color,box-shadow] hover:border-ink/25 demo-input focus:border-brand focus:outline-none aria-invalid:border-[#b42318] aria-invalid:ring-[#b42318]/10";
const labelClass = "demo-label self-start text-[13px] leading-[17px] font-medium text-ink";
const errorClass = "demo-error text-[13px] leading-[17px] text-[#b42318] empty:hidden";

const textFields = [
  { id: "name", type: "text", autocomplete: "name", ...name },
  { id: "email", type: "email", autocomplete: "email", ...email },
  { id: "clinic", type: "text", autocomplete: "organization", ...clinic },
  { id: "phone", type: "tel", autocomplete: "tel", ...phone },
] as const;
---

<div class="demo-card rounded-[28px] bg-surface p-6 sm:p-10 xl:w-[600px] xl:shrink-0" data-demo data-summary={f.errorSummary}>
  <form class="flex flex-col gap-6" novalidate data-demo-form>
    <div class="flex flex-col gap-2">
      <h2 class="text-[28px] leading-9 font-medium tracking-[-0.015em] text-ink">{f.title}</h2>
      <p class="text-base leading-[21px] text-muted">{f.description}</p>
    </div>

    <p class="sr-only" role="alert" data-demo-summary></p>

    <div class="grid gap-6 sm:grid-cols-2 sm:gap-x-4">
      {
        textFields.map((field) => (
          <div class="demo-field flex flex-col gap-2">
            <label for={`demo-${field.id}`} class={labelClass}>
              {field.label}
            </label>
            <input
              id={`demo-${field.id}`}
              name={field.id}
              type={field.type}
              autocomplete={field.autocomplete}
              placeholder={field.placeholder}
              required
              minlength={field.id === "phone" ? 7 : undefined}
              aria-describedby={`demo-${field.id}-error`}
              class={cn(input, "h-[52px]")}
            />
            <p id={`demo-${field.id}-error`} class={errorClass} data-error={field.error}></p>
          </div>
        ))
      }

      <div class="demo-field flex flex-col gap-2 sm:col-span-2">
        <label for="demo-locations" class={labelClass}>{locations.label}</label>
        <div class="relative">
          <select
            id="demo-locations"
            name="locations"
            required
            aria-describedby="demo-locations-error"
            class={cn(input, "h-[52px] appearance-none pr-12 invalid:text-muted")}
          >
            <option value="" disabled selected>{locations.placeholder}</option>
            {locations.options.map((option) => <option class="text-ink">{option}</option>)}
          </select>
          <svg class="demo-chevron pointer-events-none absolute top-1/2 right-[22px] h-[5px] w-2.5 -translate-y-1/2 text-muted" viewBox="0 0 10 5" fill="none" aria-hidden="true" data-no-draw>
            <path d="m.5.5 4.5 4 4.5-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <p id="demo-locations-error" class={errorClass} data-error={locations.error}></p>
      </div>

      <div class="demo-field flex flex-col gap-2 sm:col-span-2">
        <label for="demo-message" class={labelClass}>{message.label}</label>
        <textarea id="demo-message" name="message" rows="4" placeholder={message.placeholder} class={cn(input, "h-[140px] resize-y py-[13px]")}></textarea>
      </div>
    </div>

    <div>
      <button type="submit" class="inline-flex min-h-[52px] items-center justify-center rounded-button bg-brand px-[17px] text-base leading-6 font-medium text-canvas transition-[background-color,box-shadow,scale] duration-[250ms,300ms,450ms] ease-[ease,ease,cubic-bezier(0.34,1.56,0.64,1)] hover:scale-[1.02] hover:bg-brand-hover active:scale-[0.97] motion-reduce:hover:scale-100 disabled:opacity-80" data-sending-label={f.sending}>
        <span class="demo-spinner" aria-hidden="true"></span>
        <span data-submit-label>{f.submit}</span>
      </button>
    </div>
  </form>

  <div class="demo-success flex flex-col items-start gap-4 py-6" hidden data-demo-success>
    <span class="demo-badge relative flex size-14 items-center justify-center rounded-full bg-sky-soft" aria-hidden="true">
      <span class="demo-ripple absolute inset-0 rounded-full border-2 border-brand/40"></span>
      <svg class="size-7 text-brand" viewBox="0 0 24 24" fill="none" data-no-draw>
        <path class="demo-check" d="M5 12.5 10 17.5 19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" pathLength="1"></path>
      </svg>
    </span>
    <h2 class="demo-rise text-[28px] leading-9 font-medium tracking-[-0.015em] text-ink focus:outline-none" style="--i: 1" tabindex="-1">{f.success.title}</h2>
    <p class="demo-rise max-w-[440px] text-base leading-6 text-body" style="--i: 2">{f.success.description}</p>
    <div class="demo-rise" style="--i: 3">
      <button type="button" class={buttonClasses({ variant: "outline", size: "md" })} data-demo-again>{f.success.again}</button>
    </div>
  </div>
</div>

<style>
  /* Focus: the border turns brand blue and a soft ring grows out with a little spring; the label follows. */
  .demo-input {
    box-shadow: 0 0 0 0 rgb(44 103 246 / 0);
    transition:
      border-color 0.25s ease,
      box-shadow 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease;
  }
  .demo-input:focus {
    box-shadow: 0 0 0 4px rgb(44 103 246 / 0.14);
  }
  .demo-input[aria-invalid="true"] {
    box-shadow: 0 0 0 3px rgb(180 35 24 / 0.1);
  }
  .demo-input[aria-invalid="true"]:focus {
    box-shadow: 0 0 0 4px rgb(180 35 24 / 0.16);
  }
  .demo-label {
    transition:
      color 0.25s ease,
      translate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .demo-field:focus-within .demo-label {
    color: var(--brand);
    translate: 2px 0;
  }
  .demo-field:has([aria-invalid="true"]) .demo-label {
    color: #b42318;
  }
  .demo-chevron {
    transition:
      rotate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      color 0.25s ease;
  }
  .demo-field:focus-within .demo-chevron {
    rotate: 180deg;
    color: var(--brand);
  }
  .demo-error:not(:empty) {
    animation: demo-error-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo-shake {
    animation: demo-shake 0.42s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  /* Submit: spinner while "sending". */
  .demo-spinner {
    display: none;
    width: 16px;
    height: 16px;
    margin-right: 10px;
    border-radius: 9999px;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    animation: demo-spin 0.7s linear infinite;
  }
  [data-sending] .demo-spinner {
    display: inline-block;
  }

  /* Success: badge pops in, ring ripples out, check draws itself, text rises in. */
  .demo-success[data-play] .demo-badge {
    animation: demo-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .demo-ripple {
    opacity: 0;
  }
  .demo-success[data-play] .demo-ripple {
    animation: demo-ripple 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }
  .demo-check {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .demo-success[data-play] .demo-check {
    animation: demo-draw 0.5s cubic-bezier(0.65, 0, 0.35, 1) 0.3s both;
  }
  .demo-success[data-play] .demo-rise {
    animation: demo-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(0.25s + var(--i) * 0.08s) both;
  }
  .demo-form-in {
    animation: demo-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes demo-spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes demo-error-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }
  @keyframes demo-shake {
    20%,
    60% {
      translate: -5px 0;
    }
    40%,
    80% {
      translate: 4px 0;
    }
  }
  @keyframes demo-pop {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }
  @keyframes demo-ripple {
    from {
      opacity: 0.9;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 1.9;
    }
  }
  @keyframes demo-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes demo-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-input,
    .demo-label,
    .demo-chevron {
      transition: none;
    }
    .demo-field:focus-within .demo-label {
      translate: none;
    }
    .demo-error:not(:empty),
    .demo-shake,
    .demo-success[data-play] *,
    .demo-form-in {
      animation: none !important;
    }
    .demo-spinner {
      animation-duration: 2s;
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  /** Smoothly change the card's height while its content swaps (form ⇄ thank-you). */
  function morph(card: HTMLElement, swap: () => void) {
    const from = card.offsetHeight;
    swap();
    if (reduceMotion()) return;
    const to = card.offsetHeight;
    if (from === to) return;
    card.animate([{ height: `${from}px`, overflow: "hidden" }, { height: `${to}px`, overflow: "hidden" }], {
      duration: 600,
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
    });
  }

  document.querySelectorAll<HTMLElement>("[data-demo]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-demo-form]")!;
    const success = root.querySelector<HTMLElement>("[data-demo-success]")!;
    const summary = root.querySelector<HTMLElement>("[data-demo-summary]")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.querySelector<HTMLElement>("[data-submit-label]")!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select"));
    let submitted = false;

    const validate = (field: HTMLInputElement | HTMLSelectElement) => {
      const error = document.getElementById(`${field.id}-error`);
      let valid = field.checkValidity() && field.value.trim() !== "";
      if (field.name === "phone") valid = valid && field.value.replace(/\D/g, "").length >= 7;
      if (valid) field.removeAttribute("aria-invalid");
      else field.setAttribute("aria-invalid", "true");
      if (error) error.textContent = valid ? "" : (error.dataset.error ?? "");
      return valid;
    };

    fields.forEach((field) => {
      const recheck = () => submitted && validate(field);
      field.addEventListener("input", recheck);
      field.addEventListener("change", recheck);
      field.addEventListener("blur", recheck);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      submitted = true;
      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length) {
        summary.textContent = root.dataset.summary ?? "";
        invalid.forEach((field) => {
          field.classList.remove("demo-shake");
          void field.offsetWidth; // restart the animation
          field.classList.add("demo-shake");
        });
        invalid[0].focus();
        return;
      }
      summary.textContent = "";
      const label = submitLabel.textContent;
      submit.disabled = true;
      submit.setAttribute("data-sending", "");
      submitLabel.textContent = submit.dataset.sendingLabel ?? "";

      // TODO: send the request to your CRM or form service, e.g.
      // await fetch("https://example.com/api/demo-requests", { method: "POST", body: new FormData(form) });
      const data = Object.fromEntries(new FormData(form));
      void data;
      // Demo only: a short pause so the "sending" state is visible. Remove it once the real request is in.
      await new Promise((resolve) => setTimeout(resolve, reduceMotion() ? 0 : 700));

      submit.disabled = false;
      submit.removeAttribute("data-sending");
      submitLabel.textContent = label;
      morph(root, () => {
        form.hidden = true;
        success.hidden = false;
      });
      success.removeAttribute("data-play");
      void success.offsetWidth;
      success.setAttribute("data-play", "");
      success.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
    });

    root.querySelector<HTMLButtonElement>("[data-demo-again]")!.addEventListener("click", () => {
      form.reset();
      submitted = false;
      fields.forEach((field) => {
        field.removeAttribute("aria-invalid");
        const error = document.getElementById(`${field.id}-error`);
        if (error) error.textContent = "";
      });
      morph(root, () => {
        success.hidden = true;
        success.removeAttribute("data-play");
        form.hidden = false;
      });
      form.classList.remove("demo-form-in");
      void form.offsetWidth;
      form.classList.add("demo-form-in");
      form.querySelector("input")?.focus({ preventScroll: true });
    });
  });
</script>
