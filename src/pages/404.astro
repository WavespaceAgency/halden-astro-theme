---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TextEffects from "@/components/ui/TextEffects.astro";
import { notFound } from "@/config/pages/not-found";
import { buttonClasses } from "@/lib/button";

/** 404 – "This page missed its appointment". Text: src/config/pages/not-found.ts */
const n = notFound;
---

<BaseLayout title={n.seo.title} description={n.seo.description} noindex>
  <section
    class="nf relative isolate flex flex-col items-center gap-6 overflow-hidden px-4 py-20 text-center sm:py-[120px]"
    data-nf
    style="background: radial-gradient(55.6% 41.7% at 50% 58.3%, var(--sky-soft), #eff5fe 45%, var(--canvas) 100%)"
  >
    <p class="nf-code flex text-[140px] leading-[0.9] font-medium tracking-[-0.06em] sm:text-[200px] lg:text-[240px]" aria-hidden="true" data-nf-code>
      {
        n.code.split("").map((digit, i) => (
          <span class="nf-digit" style={`--i: ${i}`}>
            <span class="nf-float">
              <span class="nf-glyph bg-linear-to-b from-ink-2 to-brand bg-clip-text text-transparent">{digit}</span>
            </span>
          </span>
        ))
      }
    </p>
    <div class="flex max-w-[640px] flex-col items-center gap-8">
      <div class="flex flex-col items-center gap-3">
        <h1 class="text-[32px] leading-[1.3] font-medium tracking-[-0.025em] text-ink-2 sm:text-[40px]" data-split="chars">{n.title}</h1>
        <p class="max-w-[436px] text-lead text-body" data-split="words">{n.description}</p>
      </div>
      <div class="hero-reveal flex flex-wrap justify-center gap-3 pt-2" style="--delay: 0.4s">
        <a href={n.primary.href} class={buttonClasses({ size: "xl", className: "shadow-none" })}>{n.primary.label}</a>
        <a href={n.secondary.href} class={buttonClasses({ variant: "outline", size: "xl", className: "border-ink! bg-transparent!" })}>{n.secondary.label}</a>
      </div>
    </div>
  </section>
  <TextEffects />
</BaseLayout>

<style>
  /* Playful "404": the digits drop in with a spring, then float gently out of step;
     with a mouse they lean away from the pointer (each digit at its own depth) and
     the "0" spins a full turn when hovered. Reduced motion: static. */
  .nf-digit,
  .nf-float,
  .nf-glyph {
    display: inline-block;
  }
  .nf-glyph {
    /* bg-clip text needs a little room for the descender-free glyphs' gradient */
    padding-inline: 0.01em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nf-digit {
      animation: nf-drop 1s cubic-bezier(0.34, 1.45, 0.64, 1) calc(0.1s + var(--i) * 0.09s) both;
      translate: calc(var(--px, 0) * (var(--i) - 1 + 1.6) * 1px) calc(var(--py, 0) * (1.2 + var(--i) * 0.4) * 1px);
      transition: translate 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .nf-float {
      animation: nf-float 5.5s ease-in-out calc(1.1s + var(--i) * -1.3s) infinite;
    }
    .nf-glyph {
      transition: rotate 0.9s cubic-bezier(0.34, 1.45, 0.64, 1);
    }
    .nf-digit:nth-child(2):hover .nf-glyph {
      rotate: 360deg;
    }
  }
  @keyframes nf-drop {
    from {
      opacity: 0;
      transform: translateY(-60px) scale(0.85) rotate(calc((var(--i) - 1) * 8deg));
    }
  }
  @keyframes nf-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(calc((var(--i) - 1) * 1.5deg + 0.5deg));
    }
  }
</style>

<script>
  import { reduceMotion } from "@/scripts/motion";

  // Pointer parallax for the "404" digits (mouse only, skipped with reduced motion).
  const section = document.querySelector<HTMLElement>("[data-nf]");
  const code = document.querySelector<HTMLElement>("[data-nf-code]");
  if (section && code && !reduceMotion() && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let frame = 0;
    section.addEventListener("pointermove", (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = section.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        code.style.setProperty("--px", (-x * 14).toFixed(2));
        code.style.setProperty("--py", (-y * 10).toFixed(2));
      });
    });
    section.addEventListener("pointerleave", () => {
      code.style.setProperty("--px", "0");
      code.style.setProperty("--py", "0");
    });
  }
</script>
